@using BERecepcion.Core.Consulta.Copades.Dto
@model CopadeDto
@{
    Layout = null;
}

<style>
    h1 {
        color: black;
        font-family: verdana;
        font-size: 100%;
        margin: 250px;
        /* position:center;*/
    }

    p {
        font-family: sans-serif;
    }

    center {
        margin: 16px 0;
        font-family: 'Arial Unicode MS';
        font-size: 25px;
    }

    right {
        text-align: right;
    }
</style>


<hr style="color: green; background-color: green; border: 1px solid green">
<div class="row" style="width: 100%; height:150px; font-weight:lighter;" align="center">
    <b style="font-family:'Arial', sans-serif; font-weight:lighter; ">
        PEMEX EXPLORACIÓN Y PRODUCCIÓN<br />
        Codificación de Pagos y Descuentos
    </b>
    <div align="left">
        <img src="data:image/jpg;base64, " alt="logo" width="220" height="85" />
    </div>
    <div align="right">
        <b style="font-size:13px; font-weight:lighter;" align="right">@DateTime.Now.ToString("dd/MM/yyyy")</b>
    </div>
</div>
<hr style="color: red; background-color: red; border: 1px solid #ff0000">

<table>
    <thead>
        <tr>
            <th style="width:450px"></th>
            <th style="width:270px"></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><b style="font-family:'Arial Unicode MS'; font-size:13px; font-weight: lighter;">Número de Acreedor SAP:</b><b style="font-weight:bold; font-size:13px;"> @Model.CreditorNumber</b></td>
            <td><b style="font-family:'Arial Unicode MS'; font-size:13px; font-weight: lighter;">No.COPADE: </b><b style="font-weight:bold; font-size:13px;">@Model.Reception</b></td>
        </tr>
        <tr>
            <td height="1px"><b style="font-family:'Arial Unicode MS'; font-size:13px; font-weight: lighter;">Nombre de Acreedor: </b><b style="font-weight:bold; font-size:13px;">@Model.Creditor</b><br /></td>
            <td height="1px">
                <b style="font-family:'Arial Unicode MS'; font-size:13px; font-weight: lighter;">Fecha de Emisión: </b><b style="font-weight:bold; font-size:13px;">@Model.ReleaseDate?.ToString("dd/MM/yyyy")</b><br />
                <b style="font-family:'Arial Unicode MS'; font-size:13px; font-weight: lighter;">No.Contrato: </b><b style="font-weight:bold; font-size:13px;">@Model.Contract</b>
            </td>
        </tr>
        <tr>
            <td></td>
            <td height="1px"><b style="font-family:'Arial Unicode MS'; font-size:13px; font-weight: lighter;">Macroproyecto/Fideicomiso: </b><b style="font-weight:bold; font-size:13px;">@Model.Macroproject+@Model.Trust</b></td>
        </tr>
        <tr>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td>
                <b style="font-family: 'Arial Unicode MS'; font-size:14px; font-weight:lighter;">Importe: </b><b style="font-weight:bold; font-size:14px; padding-left: 1em;">&nbsp;$@Convert.ToDecimal(@Model.Amount).ToString("N2")</b>
                <b style="padding-left: 3em;"></b>
                <b style="font-family: 'Arial Unicode MS'; font-size:14px; font-weight: lighter; padding-left: 2em;">Moneda:</b><b style="font-weight:bold; font-size:14px; padding-left: 2em;">&nbsp;&nbsp;@Model.Currency</b>
            </td>
            <td><b style="font-family: 'Arial Unicode MS'; font-size:14px; font-weight: lighter;">No. Est/Rem: </b><b style="font-weight:bold; font-size:14px;">@Model.Esteem</b></td>
        </tr>
        <tr>
            <td>
                <b style="font-family: 'Arial Unicode MS'; font-size:13px; font-weight: lighter; padding-left: 1em;">&nbsp;&nbsp; IVA: </b><b style="font-weight:bold; font-size:13px; padding-left: 2em;"> $@Convert.ToDecimal(@Model.Iva).ToString("N2")</b>
                <b style="padding-left: 5em;"></b>
                <b style="font-family: 'Arial Unicode MS'; font-size:13px; font-weight: lighter;">TOTAL:</b><b style="font-weight:bold; font-size:13px; padding-left: 2em;">$@Convert.ToDecimal(@Model.PayEquity).ToString("N2")</b>
            </td>
            <td><b style="font-family: 'Arial Unicode MS'; font-size:13px; font-weight: lighter;">Sociedad: </b><b style="font-weight:bold; font-size:13px;"> @Model.Society</b></td>
        </tr>
        <tr>
            <td></td>
            <td><b style="font-family: 'Arial Unicode MS';font-weight: lighter; font-size:13px;">Folio SCE/ID Suministro: </b><b style="font-weight:bold; font-size:13px;">@Model.RefPayment</b></td>
        </tr>
        <tr>
            <td></td>
            <td><b style="font-family: 'Arial Unicode MS';font-weight: lighter; font-size:13px;">VU/Asignación: </b><b style="font-weight:bold; font-size:13px;">@Model.Assignment</b></td>
        </tr>
        <tr>
            <td><b style="font-family: 'Arial Unicode MS';font-weight: lighter; font-size:13px;">Descripción de Bien y Servicio: </b><b style="font-weight:bold; font-size:13px;">@Model.Desc</b></td>
            <td></td>
        </tr>
    </tbody>
</table>

<div class="col-md-12" style="overflow-x: visible">
    <table style="width: 100%;" cellpadding="0" cellspacing="0">
        <caption style="font-size: 14px; font-family:'Arial Unicode MS';font-weight:bolder;"><b>Aceptación del Bien o Servicio</b></caption>
        <thead>
            <tr style="background-color:#848484; font-family:Arial; font-size:13px;text-align:center;border-top-width:0px;border-left-width:0px;">
                <th class="text-center" scope="col" style="border: 1px solid black; font-weight:lighter;">Pedido SAP</th>
                <th class="text-center" scope="col" style="border: 1px solid black; font-weight:lighter;">Recepción <br />de bien(s)</th>
                <th class="text-center" scope="col" style="border: 1px solid black; font-weight:lighter;">Importe</th>
                <th class="text-center" scope="col" style="border: 1px solid black; font-weight:lighter;">Fecha cont.<br />Aceptación</th>
                <th class="text-center" scope="col" style="border: 1px solid black; font-weight:lighter;">Tipo de <br />Cambio</th>
            </tr>
        </thead>
        <tbody>

            @foreach (var datosp in Model.vDetallePep)
            {
                <tr>
                    <td height="25px" style="border-bottom:groove"><b style="font-size:13px; font-weight:lighter; padding-left: 4em; ">@datosp.SapOrder</b></td>
                    <td height="25px" style="border-bottom:groove"><b style="font-size:13px; font-weight:lighter; padding-left: 4em; ">@datosp.ReceptionDate</b></td>
                    <td height="25px" style="border-bottom:groove"><b style="font-size:13px; font-weight:lighter; padding-left: 4em; ">@Convert.ToDecimal(@datosp.Amount).ToString("N2")</b></td>
                    <td height="25px" style="border-bottom:groove"><b style="font-size:13px; font-weight:lighter; padding-left: 4em; ">@Convert.ToDateTime(@datosp.AcceptanceDate).ToString("dd/MM/yyyy")</b></td>
                    <td height="25px" style="border-bottom:groove"><b style="font-size:13px; font-weight:lighter; padding-left: 2em; ">@datosp.ChangeType</b></td>
                </tr>
            }
        </tbody>
    </table>
</div>

<br />

<div class="col-md-12">
    <table class="table table-hover" style="width: 100%" height="10%" cellpadding="0" cellspacing="0">
        <caption style="font-size: 14px; font-family:'Arial Unicode MS';font-weight:bolder;"><b>Retenciones y Deducciones de Importe Estimado</b></caption>
        <thead>
            <tr border="1" height="2px" style="background-color:#848484; font-family:Arial; font-size:13px;text-align:center;border-top-width:0px;border-left-width:0px;">
                <th class="text-center" scope="col" style="font-weight: lighter;">Tipo</th>
                <th class="text-center" scope="col" style="font-weight: lighter;">Concepto</th>
                <th class="text-center" scope="col" style="font-weight: lighter;">Cantidad</th>
                <th class="text-center" scope="col" style="font-weight: lighter;">IVA</th>
                <th class="text-center" scope="col" style="font-weight: lighter;">Total</th>
            </tr>
        </thead>
        <tbody>

            @*DETALLE*@

            @if (Model.vDetalle.FirstOrDefault() != null)
                @foreach (var datospdos in Model.vDetalle)
                {
                    <tr>
                        <td height="25px" style="border-bottom:groove"><b style="font-size: 13px; font-weight:lighter; padding-left: 2em; ">@datospdos.Type</b></td>
                        <td height="25px" style="border-bottom:groove"><b style="font-size: 13px; font-weight:lighter; padding-left: 2em;">@datospdos.Concept</b></td>
                        <td height="25px" style="border-bottom:groove"><b style="font-size: 13px; font-weight:lighter; padding-left: 2em;">@datospdos.Quantity</b></td>
                        <td height="25px" style="border-bottom:groove"><b style="font-size: 13px; font-weight:lighter; padding-left: 2em;">@( datospdos.Iva != "" ? datospdos.Iva : "0" )</b></td>
                        @*<td><center style="font-size: 14px; font-weight:lighter;">@datospdos.Iva</center><hr style="color: black; border: 1px solid black"></td>*@
                        <td height="25px" style="border-bottom:groove"><b style="font-size: 13px; font-weight:lighter; padding-left: 2em;">@datospdos.Total</b></td>
                    </tr>

                }

                @*NOTA DE CREDITO*@
            @if (Model.vNotasCredito != null)
                @foreach (var datospdos in Model.vNotasCredito.notaCredito)
                {
                    <tr>
                        <td height="25px" style="border-bottom:groove"><b style="font-size: 13px; font-weight:lighter; padding-left: 2em;">@datospdos.Tipo</b></td>
                        <td height="25px" style="border-bottom:groove"><b style="font-size: 13px; font-weight:lighter; padding-left: 2em;">@datospdos.Concepto</b></td>
                        <td height="25px" style="border-bottom:groove"><b style="font-size: 13px; font-weight:lighter; padding-left: 2em;">@datospdos.Cantidad</b></td>
                        <td height="25px" style="border-bottom:groove"><b style="font-size: 13px; font-weight:lighter; padding-left: 2em;">@( datospdos.Iva != "" ? datospdos.Iva : "0" )</b></td>
                        @*<td><center style="font-size: 14px; font-weight:lighter;">@datospdos.Iva</center><hr style="color: black; border: 1px solid black"></td>*@
                        <td height="25px" style="border-bottom:groove"><b style="font-size: 13px; font-weight:lighter; padding-left: 2em;">@datospdos.Total</b></td>
                    </tr>

                }
        </tbody>
    </table>
</div>
@*<hr style="color: black; border: 1px solid black">*@

<p style="font-family:'Arial Unicode MS';" align="right">Neto a Pagar: <b style="font-family:'Arial Unicode MS';font-weight:lighter;">$@Convert.ToDecimal(@Model.PayEquity).ToString("N2")</b></p>

<div style="border:1px solid black; background-color:rgb(193, 194, 193); font-weight:lighter; font-size:15px;" align="center">
    <p>
        <b style="font-size: 13px;font-weight: bold;">OBSERVACIONES</b><br />
        Los bienes o servicios contratados, han sido recibidos a entera satisfacción y
        conforme a los términos y condiciones pactados , apegádose al apartado de la normatividad
        de tesorería de Pemex Exploración y Producción.
    </p>
</div>

<center><p style="font-size: 13px;">Autorizo</p></center>
<center><p style="font-size: 13px;">@Model.Authorizes</p></center>
<br />
<br />
<br />
<br />
<br />
<div align="right">
    Página 1 de 1
</div>






