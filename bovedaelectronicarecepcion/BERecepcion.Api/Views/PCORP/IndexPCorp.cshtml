@using BERecepcion.Core.Consulta.Copades.Dto
@model CopadeDto
@{
    Layout = null;
}

<style>
    body{
        font-family:Arial;
    }
    .rowPDF {
        width: 100%;
        margin: auto;
    }

    .colmd12{
        width:100%;
    }

    .colmd6{
        width:44%;
        display:inline-block;
    }

    .colmd4{
        width:23%;
        display:inline-block;
    }

    .colmd3 {
        width: 14%;
        display: inline-block;
    }

    .textcenter{
        text-align:center;
    }

    .textright{
        text-align:right;
        padding-right:10px;
    }

    .borderSQR{
        border-color: black;
        border:1px solid;
        /*padding-left:15px;
        padding-right:15px;*/
    }

    .borderSQRNP {
        border-color: black;
        border: 1px solid;
    }

    .nopadding{
        padding-left:0px!important;
        padding-right:0px!important;
    }

    .leftpadding {
        padding-left: 15px !important;
    }

    .textSQR{
        text-align:justify;
    }
</style>

<div class="rowPDF">
    <!--logotipo-->
    <div class="textcenter">
        <img src="data:image/jpg;base64," alt="logo" />
    </div>
    <div class="textcenter">
        <p><b style="font-family:'Arial Unicode MS'; font-weight:lighter;">PETROLEOS MEXICANOS <br /> CORPORATIVO  <br /> CODIFICACIÓN DE PAGOS Y DESCUENTOS</b></p>
    </div>
    <div class="row">
        <table style="border: 1px solid #000000;background-color:white; width: 100%; font-family: 'Arial Unicode MS' ; font-size: 16px; font-weight: lighter; padding-left:1em" align="left" cellpadding="0" cellspacing="0">
            <thead>
                <tr>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><p></p>No. de Certificado: @Model.CertificateNumber</td>
                    <td> Fecha de EM/ES: @Model.ReleaseDate?.ToString("dd/MM/yyyy") </td>
                </tr>
                <tr>
                    <td style="color:white">.</td>
                    <td></td>
                </tr>
                <tr>
                    <td>Recepcion de Bienes y/o Servicios: @Model.Receipt<p></p></td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="borderSQR" style="padding-left:1em">
        <p style="color:white">.</p>
        Se expide el presente certificado de aceptaci&oacute;n del acreedor:<b>@Model.CreditorNumber</b> 
        <b>@Model.Creditor</b>con Registro Federal de Contribuyentes (R.F.C.)<b>&nbsp;@Model.CreditorRfc</b>&nbsp;
        ,mismo que avala a entera satisfacci&oacute;n de quienes suscriben, la recepci&oacute;n de bienes y/o servicios conforme a los t&eacute;rminos y condiciones pactados en el pedido o contrato.
        <br /><br />
        &nbsp;No. de factura o recibo: @Model.Receipt
        <br /><br />
        &nbsp;No. de pedido o contrato: @Model.SapOrder
        <br /><br />
        <br /><br />
        <br /><br />
        <br /><br />
    </div>
    <div class="borderSQR nopadding">
        <div class="colmd6 textcenter">
            <p>Concepto</p>
        </div>
        <div class="colmd3 textcenter">
            <p>Percepciones</p>
        </div>
        <div class="colmd4 textcenter">
            <p>Deducciones</p>
        </div>
        <div class="colmd3 textcenter">
            <p>I.V.A.</p>
        </div>
    </div>
    <div class="borderSQR nopadding">
        @{
            if (Model.vDetalle != null)
            {
                foreach (var item in Model.vDetalle)
                {
                    <div>
                        <br />
                        <div class="colmd6 leftpadding">
                            @item.Concept
                        </div>
                        <div class="colmd3 textright">
                            @Convert.ToDecimal(item.Perception).ToString("N2")
                        </div>
                        <div class="colmd3 textright">
                            @Convert.ToDecimal(item.Deduction).ToString("N2")
                        </div>
                        <div class="colmd4 textright">
                            @Convert.ToDecimal(item.Iva).ToString("N2")
                        </div>
                    </div>
                    <br />
                }
            }
        }
    </div>
    <div>
        <div class="textcenter">
            <br />
            <span><strong><u>Neto a pagar</u>============================== @Convert.ToDecimal(@Model.PayEquity).ToString("N2")</strong></span>
            <br />
            <br />
        </div>
        <div>
            <b style="font-family:'Arial Unicode MS'; font-weight:lighter; font-size: 13px;">Moneda: @Model.Currency &nbsp;&nbsp;&nbsp;&nbsp;@Model.PointAmount</b>
        </div>
        <div>
            <b style="font-family:'Arial Unicode MS'; font-weight:lighter; font-size: 13px;">Observaciones: @Model.Comments</b>
        </div>
    </div>
    <br /><br />
    <br /><br />
    <br /><br />
    <br /><br />
    <br /><br />
          <div class="col-lg-12 col-md-12 col-sm-12">
              <table style="width: 100%; font-family: 'Arial Unicode MS' ; font-size: 16px; font-weight: lighter;" align="left" cellpadding="0" cellspacing="0">
                  <thead>
                      <tr>
                          <th></th>
                      </tr>
                  </thead>
                  <tbody>
                      <tr>
                          <td width="20%" align="left">@Model.NoCad</td>
                          <td width="20%" align="right">Página 1 de 1</td>
                      </tr>
                  </tbody>
              </table>
          </div>
</div>


