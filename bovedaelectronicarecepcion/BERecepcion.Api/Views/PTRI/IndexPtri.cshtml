@using BERecepcion.Core.Consulta.Copades.Dto
@model CopadeDto
@{
    Layout = null;
    string tAnticipo = Model.vDetalleObra.Tipo == "A" ? "X" : " ";
    string tEstimacion = Model.vDetalleObra.Tipo == "E" ? "X" : " ";
    string tFiniquito = Model.vDetalleObra.Tipo == "F" ? "X" : " ";
}
<style>
    p {
        font-family: 'Arial Unicode MS';
        font-size: 12px;
        margin: 4px;
    }

    .b {
        position: absolute;
        right: 30px;
        width: 100%;
        /*        height: 120px;*/
    }

    .row {
        width: 100%;
    }

</style>
<div style="width: 100%; margin: 0 auto 0 auto;">
    <table>
        <thead>
            <tr>
                <th></th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                @*<td><img src="data:image/jpg;base64, " alt="logo" width="330" height="100"  /></td>*@
                <td><img src="data:image/jpg;base64, " alt="logo" width="300" height="90" /></td>
                <td width="70%" align="center"><strong style="font-size:15px; font-family:Arial, Helvetica, sans-serif"><b>CODIFICACIÓN DE PAGOS Y DESCUENTOS</b></strong></td>
            </tr>
        </tbody>
    </table>

    <div style="border:1px solid #000000; font-weight:lighter; font-size: 7px;" align="right">
        <p><p>Fecha de Emisión: @Convert.ToDateTime(Model.FechaEmision).ToString("dd/MM/yyyy")</p></p>
    </div>

    <div style="border:1px solid black; background-color:rgb(193, 194, 193); text-align:center">
        <p style="font-size:10px; font-family:Arial;font-weight:lighter;">
            SE EXPIDE EL PRESENTE CERTIFICADO PARA PAGO POR LOS BIENES Y/O SERVICIOS<br />
            RECIBIDOS A ENTERA SATIFACCIÓN Y CONFORME A LOS TÉRMINOS Y CONDICIONES PACTADOS
        </p>
    </div>

    <div>
        <table style="border: 1px solid #000000;background-color:white; width: 100%; font-family: Arial ; font-size: 9px; font-weight: lighter;" align="left" cellpadding="0" cellspacing="0">
            <thead>
                <tr>
                    <th style="width:300px; height:3px"></th>
                    <th style="width:200px; height:3px"></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><p></p>&nbsp;&nbsp;Nombre del Acreedor: @Model.Creditor</td>
                    <td>Número de Acredor SAP: @Model.CreditorNumber</td>
                </tr>
                <tr>
                    <td>&nbsp;&nbsp;Número de contrato abierto: @Model.Contract</td>
                    <td></td>
                </tr>
                <tr>
                    <td>&nbsp;&nbsp;Número de Pedido SAP / Orden de surtimiento: @Model.SapOrder<p></p></td>
                    <td></td>
                </tr>
            </tbody>
        </table>
    </div>
        <div style="border:1px solid black; background-color:rgb(193, 194, 193); text-align:center">
            <b style="font-size: 10px; font-family:Arial ;font-weight:bold;">
                MATERIALES
            </b>
        </div>

        <div>
            <table style="border: 1px solid #000000;background-color:white; width: 100%; font-family: Arial ; font-size: 9px; font-weight: lighter;" align="left" cellpadding="0" cellspacing="0">
                <thead>
                    <tr>
                        <th style="width:300px; height:3px"></th>
                        <th style="width:300px; height:3px"></th>
                        <th style="width:400px; height:3px"></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><p></p>&nbsp;&nbsp;Fecha limite de Entrega:@( Model.DocumentType=="B" ? @Convert.ToDateTime(Model.DeliveryLimitDate).ToString("dd/MM/yyyy") : null )</td>
                        <td>Fecha real de Entrega: @( Model.DocumentType=="B" ? @Convert.ToDateTime(Model.DeliveryRealDate).ToString("dd/MM/yyyy") : null )</td>
                        <td> Días de Diferencia:@( Model.DocumentType=="B" ? @Model.DiferenceDays : null )</td>
                    </tr>
                    <tr>
                        <td>&nbsp;&nbsp;% Sanción Aplicable:@( Model.DocumentType=="B" ? @Model.ApplicablePunishment : null )</td>
                        <td><p></p></td>
                        <td>Entrada de material en:@( Model.DocumentType=="B" ? @Model.Reception : null )<p></p></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div style="border:1px solid black; background-color:rgb(193, 194, 193); text-align:center">
            <b style="font-size:10px; font-family:Arial;font-weight:bold;">
                SERVICIOS
            </b>
        </div>

        <div>
            <table style="border: 1px solid #000000;background-color:white; width: 100%; font-family: 'Arial Unicode MS' ; font-size: 9px; font-weight: lighter;" align="left" cellpadding="0" cellspacing="0">
                <thead>
                    <tr>
                        <th style="width:300px; height:3px"></th>
                        <th style="width:300px; height:3px"></th>
                        <th style="width:400px; height:3px"></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><p></p>&nbsp;&nbsp;Fecha limite de Entrega:@( Model.DocumentType=="S" ? @Convert.ToDateTime(Model.DeliveryLimitDate).ToString("dd/MM/yyyy") : null )</td>
                        <td>Fecha real de Entrega:@( Model.DocumentType=="S" ? @Convert.ToDateTime(Model.DeliveryRealDate).ToString("dd/MM/yyyy") : null ) </td>
                        <td>Documento de aceptación en SAP: @( Model.DocumentType=="S" ? @Model.AcceptDocument : null )</td>
                    </tr>
                    <tr>
                        <td>&nbsp;&nbsp;% Sanción Aplicable: @( Model.DocumentType=="S" ? @Model.ApplicablePunishment : null )</td>
                        <td><p></p></td>
                        <td>Hoja de entrada de Servicios: @( Model.DocumentType=="S" ? @Model.EntryForm : null )<p></p></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div style="border:1px solid black; background-color:rgb(193, 194, 193); text-align:center">
            <b style="font-size:10px; font-family:Arial;font-weight:bold;">
                ESTIMACIONES - OBRA
            </b>
        </div>

        <div>
            <table style="border: 1px solid #000000;background-color:white; width: 100%; font-family: 'Arial Unicode MS' ; font-size: 9px; font-weight: lighter;" align="left" cellpadding="0" cellspacing="0">
                <thead>
                    <tr>
                        <th style=" height:3px"></th>
                        <th style=" height:2px"></th>
                        <th style=" height:3px"></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><p></p>&nbsp;&nbsp;Número de Estimación: @( Model.DocumentType=="O" ? @Model.EstimatedNumber : null )</td>
                        <td></td>
                        <td>Período de la estimación: @( Model.DocumentType=="O" ? @Model.EstimationPeriod : null )</td>
                    </tr>
                    <tr>
                        <td>&nbsp;&nbsp;Documento de aceptación en SAP: @( Model.DocumentType=="O" ? @Model.AcceptDocument : null )</td>
                        <td></td>
                        <td>Hoja de entrada de Servicios: @( Model.DocumentType=="O" ? @Model.EntryForm : null )</td>
                    </tr>
                    <tr>
                        @*verificar*@
                        <td>&nbsp;&nbsp;Fecha de autorización de la estimación por la residencia de obra: @( Model.DocumentType=="O" ? @Convert.ToDateTime(Model.ReleaseDate).ToString("dd/MM/yyyy") : null )<p></p></td>
                        <td></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
        </div>
    <div style="border:1px solid black; background-color:rgb(193, 194, 193); text-align:center">
        <b style="font-size:10px; font-family:Arial;font-weight:bold;">
            AFECTACIÓN PRESUPUESTAL
        </b>
    </div>

    <div>
        <table style="border: 1px solid #000000;background-color:white; width: 100%; font-family: 'Arial Unicode MS' ; font-size: 9px;  font-weight: lighter;" align="left" cellpadding="0" cellspacing="0">
            <thead>
                <tr>
                    <th></th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><p></p>&nbsp;&nbsp;Centro de departamento: @Model.Center<p></p></td>
                    <td><p></p>Pospre: @Model.Pospre<p></p></td>
                    <td><p></p>División: @Model.Division<p></p></td>
                </tr>
            </tbody>
        </table>
    </div>
    @*<td></td>*@
    <div style="border:1px solid black; background-color:rgb(193, 194, 193); text-align:center">
        <b style="font-size:10px; font-family:Arial;font-weight:bold;">
            DETALLE DEL PAGO
        </b>
    </div>

    <div>
        <table style="border: 1px solid #000000;background-color:white; width: 100%; font-family: 'Arial Unicode MS' ; font-size: 7px; font-weight: lighter;" align="right" cellpadding="0" cellspacing="0">
            <thead>
                <tr>
                    <th style="width:150px"><p></p>Adquisiciones,servicios <br />y Miscelaneos</th>
                    @*<th style="width:218px"></th>*@
                    <th style="width:250px">Concepto</th>
                    <th style="width:250px">Percepciones</th>
                    <th style="width:250px">Deducciones<p></p></th>
                </tr>
            </thead>
            <tbody>

                @if (Model.vDetalle != null)
                {
                    foreach (var adquisicion in Model.vDetalle)
                    {
                <tr>

                    <td><b style="font-size: 8px; font-family: 'Arial Unicode MS';"></b></td>
                    <td><left style="font-size: 8px; font-family: 'Arial Unicode MS';">@adquisicion.Concept</left></td>
                    <td width="20%" align="right"><b style="font-size: 10px; font-family: 'Arial Unicode MS';"></b>@adquisicion.Perception</td>
                    <td width="40%" align="right"><b style="font-size: 10px; font-family: 'Arial Unicode MS'; padding-left: 15em; font-weight: lighter;"></b>@adquisicion.Deduction<b style="font-size: 7px; padding-left: 10em; color:transparent">.</b></td>
                </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div>
        <table style="border: 1px solid #000000;background-color:white; width: 100%; font-family: 'Arial Unicode MS' ; font-size: 7px; font-weight: lighter;" align="left" cellpadding="0" cellspacing="0">
            <thead>
                <tr>
                    <th style="width:165px"><p></p>Boletos de Avión</th>
                    @*<th style="width:288px"></th>*@
                    <th style="width:250px">Concepto</th>
                    <th style="width:250px">Percepciones</th>
                    <th style="width:250px">Deducciones<p></p></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.vDetalleAvion != null)
                {
                    foreach (var boleto in Model.vDetalleAvion)
                    {
                        <tr>
                            @*<td></td>*@
                            <td><b style="font-size: 8px; font-family: 'Arial Unicode MS' ;"></b></td>
                            <td><left style="font-size: 8px; font-family: 'Arial Unicode MS' ;">@boleto.Concept</left></td>
                            <td width="20%" align="right"><b style="font-size: 10px; font-family: 'Arial Unicode MS';"></b>@boleto.Perception</td>
                            <td width="40%" align="right"><b style="font-size: 7px; font-family: 'Arial Unicode MS'; padding-left: 15em; font-weight: lighter;">@boleto.Deduction<b style="font-size: 7px; padding-left: 10em; color:transparent">.</b></b></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div>
        <table style=" border: 1px solid #000000; background-color: white; width: 100%; font-family: 'Arial Unicode MS'; font-size: 7px; font-weight: lighter;" align="left" cellpadding="0" cellspacing="0">
            <thead>
                <tr>
                    <th style="width:165px"><p></p>Obra Publica </th>
                    @*<th style="width:263px"></th>*@
                    <th style="width:250px">Concepto</th>
                    <th style="width:250px">Percepciones</th>
                    <th style="width:250px">Deducciones<p></p></th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>&nbsp;&nbsp;Anticipo(@tAnticipo)</td>
                </tr>
                <tr>
                    <td>&nbsp;&nbsp;Estimación(@tEstimacion)</td>
                </tr>
                <tr>
                    <td>&nbsp;&nbsp;Finiquito(@tFiniquito)</td>
                </tr>
                @if (Model.vDetalleObra != null)
                {
                    foreach (var adquisicion in Model.vDetalleObra.Detalle)
                    {
            <tr>
                @*<td></td>*@
                <td><b style="font-size: 8px; font-family: 'Arial Unicode MS' ;"></b></td>
                <td><left style="font-size: 8px; font-family: 'Arial Unicode MS' ;">@adquisicion.Concept</left></td>
                <td width="20%" align="right"><b style="font-size: 10px; font-family: 'Arial Unicode MS';"></b>@adquisicion.Perception</td>
                <td width="40%" align="right"><b style="font-size: 7px; font-family: 'Arial Unicode MS'; padding-left: 15em; font-weight: lighter;">@adquisicion.Deduction<b style="font-size: 7px; padding-left: 10em; color:transparent">.</b></b></td>
            </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
