@model IEnumerable<CartaPorteViewModel>

<div class="card card-outline card-olive">
    <div class="card-header">
        <h4 class="card-title">
            <i class="fas fa-info mr-2"></i>Detalle del complemento Carta Porte
        </h4>
    </div>
    <div class="card-body">
        @foreach (var item in Model)
        {
            <div class="row">
                <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
                    <div class="callout callout-info">
                        <h5>
                            <i class="fas fa-dot-circle mr-2"></i>
                            Origen
                        </h5>
                        <hr />
                        <h6>
                            <label>Fecha y hora de salida:</label> @item.Origen.FechaHoraSalidaLlegada.ToString("dd/MM/yyyy HH:mm:ss")  @item.Origen.RFCRemitenteDestinatario  @item.Origen.NombreRemitenteDestinatario
                        </h6>
                        <h6>
                            @item.Origen.Domicilio.Calle @item.Origen.Domicilio.NumeroExterior @item.Origen.Domicilio.NumeroInterior
                        </h6>
                        <h6>
                            @item.Origen.Domicilio.DomicilioCompleto
                        </h6>
                    </div>
                </div>
                <div class="col-12 col-sm-12 col-md-6 col-lg-6 col-xl-6">
                    <div class="callout callout-info">
                        <h5>
                            <i class="fas fa-flag-checkered mr-2"></i>
                            Destino
                        </h5>
                        <hr />
                        <h6>
                            <label>Fecha y hora de prog. llegada:</label> @item.Destino.FechaHoraSalidaLlegada.ToString("dd/MM/yyyy HH:mm:ss") @item.Destino.RFCRemitenteDestinatario @item.Destino.NombreRemitenteDestinatario
                        </h6>
                        <h6>
                            @item.Destino.Domicilio.Calle @item.Destino.Domicilio.NumeroExterior @item.Destino.Domicilio.NumeroInterior
                        </h6>
                        <h6>
                            @item.Destino.Domicilio.DomicilioCompleto
                        </h6>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="callout callout-info">
                        <h5 class="mb-3">
                            <i class="fas fa-cubes mr-2"></i> Detalle de mercancías
                        </h5>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover m-0">
                                <thead>
                                    <tr>
                                        <th>Bienes transportados</th>
                                        <th>Cve Unidad</th>
                                        <th>Cantidad</th>
                                        <th>Tipo Material Peligroso</th>
                                        <th>Fracción Arancelaria</th>
                                        <th>Peso</th>
                                        <th>Valor</th>
                                        <th>Moneda</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                            <td>@item.Mercancia.BienesTransp @item.Mercancia.Descripcion</td>
                                            <td>@item.Mercancia.ClaveUnidad</td>
                                            <td>@item.Mercancia.Cantidad</td>
                                            <td>@item.Mercancia.CveMaterialPeligroso</td>
                                            <td>????</td>
                                            <td>@item.Mercancia.PesoEnKg</td>
                                            <td>@item.Mercancia.ValorMercancia</td>
                                            <td>@item.Mercancia.Moneda</td>
                                        </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="callout callout-info">
                        <h5 class="mb-3">
                            <i class="fas fa-truck-moving mr-2"></i> Autotransporte federal
                        </h5>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover m-0">
                                <thead>
                                    <tr>
                                        <th>Tipo Permiso SCT</th>
                                        <th>Permiso SCT</th>
                                        <th>Aseguradora</th>
                                        <th>Poliza Seguro</th>
                                        <th>Config Vehicular</th>
                                        <th>Placas</th>
                                        <th>Año Modelo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>@item.Autotransporte.NumPermisoSCT</td>
                                        <td>@item.Autotransporte.PermSCT</td>
                                        <td>@item.Autotransporte.Seguros.AseguraRespCivil</td>
                                        <td>@item.Autotransporte.Seguros.PolizaRespCivil</td>
                                        <td>@item.Autotransporte.IdentificacionVehicular.ConfigVehicular</td>
                                        <td>@item.Autotransporte.IdentificacionVehicular.PlacaVM</td>
                                        <td>@item.Autotransporte.IdentificacionVehicular.AnioModeloVM</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover m-0">
                                <thead>
                                    <tr>
                                        <th>Remolque 1</th>
                                        <th>Placa</th>
                                        <th>Remolque 2</th>
                                        <th>Placa</th>
                                        <th>Contenedor 1</th>
                                        <th>Contenedor 2</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>@item.Autotransporte.Remolques[0].SubTipoRem</td>
                                        <td>@item.Autotransporte.Remolques[0].Placa</td>
                                        <td>@item.Autotransporte.Remolques[1].SubTipoRem</td>
                                        <td>@item.Autotransporte.Remolques[1].Placa</td>
                                        <td>????</td>
                                        <td>????</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <div class="callout callout-info">
                        <h5 class="mb-3">
                            <i class="fas fa-truck-moving mr-2"></i> Figuras de transporte
                        </h5>
                        <div class="table-responsive">
                            <table class="table table-striped table-hover m-0">
                                <thead>
                                    <tr>
                                        <th>RFC</th>
                                        <th>Nombre</th>
                                        <th>Licencia</th>
                                        <th>Domicilio</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>@item.FiguraTransporte.RFCFigura</td>
                                        <td>@item.FiguraTransporte.NombreFigura</td>
                                        <td>@item.FiguraTransporte.NumLicencia</td>
                                        <td>@item.FiguraTransporte.Domicilio</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
