@model BERRecepcion.Front.Models.Dto.UnionReactivarProcesosDto
@using BERRecepcion.Front.Utilities; 

@section scripts
{
    <script type="text/javascript" src="@Url.Content("~/js/ReactivaProcesos/index.js" )"></script>
}

@if (Model.ReactivaProcesosFirma != null)
{
<div class="card">
    <div class="card-body">
        <table class="table table-hover" id="reactiva-table" style="font-size:14px;">
            <thead class="thead-light">
                <tr>
                    <th>Tipo de Documento</th>
                    <th>Orden SAP</th>
                    <th>Estatus</th>
                    <th>Contrato</th>
                    <th>Organismo</th>
                </tr>
            </thead>
            <tbody>
                <tr style="vertical-align:middle;">
                    <td scope="row" class="align-middle">@Model.ReactivaProcesosFirma.TypeDocument</td>
                    <td scope="row" class="align-middle">@Model.ReactivaProcesosFirma.SAPOrderRP</td>
                    <td scope="row" class="align-middle">@Model.ReactivaProcesosFirma.Type</td>
                    <td scope="row" class="align-middle">@Model.ReactivaProcesosFirma.Contract</td>
                    <td scope="row" class="align-middle">@Model.ReactivaProcesosFirma.Clave</td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="card-body">
        <button class="btn btn-sm btn-outline-success float-left" style="width:155px;" onclick="InsertarRP('@Model.ReactivaProcesosFirma.SAPOrderRP','@Model.ReactivaProcesosFirma.Name','@Model.ReactivaProcesosFirma.TypeDocument','@Model.ReactivaProcesosFirma.Type','@Model.ReactivaProcesosFirma.Clave','@Model.ReactivaProcesosFirma.Contract','@Model.ReactivaProcesosFirma.Type');">
            Enviar <i class="fas fa-paper-plane ml-1"></i>
        </button>
    </div>
    <!-- /.card-body -->
</div>
    
    <script>
        $(function () {
            DataTableInitialize("reactiva-table");
        });
    </script>

    <div class="row mt-2">
        <div class="col-lg-12 col-md-12 col-sm-12 text-center">
            <h5>Resultado de Tarea</h5>
        </div>
    </div>


    if (Model != null && Model.ReactivaProcesosDatos != null && Model.ReactivaProcesosDatos.Count() > 0)
    {

        foreach (var item in Model.ReactivaProcesosDatos)
        {
            <div class="row">
                <div class="col-md-12">
                    <!-- The time line -->
                    <div class="timeline">
                        <!-- timeline time label -->
                        <div class="time-label">
                            <span class=" @(item.Mensaje == "Exitoso" ? "bg-green" : "bg-red")">
                                @if (item.Firmante1)
                                {
                                    @item.FechaEnvioTarea1.ToString("dd/MM/yyyy hh:mm:ss")<span> (OS)</span>  
                                }
                                else
                                {
                                    @item.FechaEnvioTarea2.ToString("dd/MM/yyyy hh:mm:ss")<span> (Estimación)</span>
                                }
                            </span>
                        </div>
                        <!-- /.timeline-label -->
                        <!-- timeline item -->
                        <div>
                            <i class="fas fa-envelope @(item.Mensaje == "Exitoso" ? "bg-green" : "bg-red")"></i>
                            <div class="timeline-item">
                                @*<span class="time"><i class="fas fa-clock"></i> @DateTime.Now.ToString("hh:mm")</span>*@
                                <h3 class="timeline-header">@item.Mensaje</h3>

                                <div class="timeline-body" style="overflow-x: auto;">
                                    @if (item.Firmante1)
                                        @Html.setHtmlText(item.ResultadoTarea1)
                                        else
                                            @Html.setHtmlText(item.ResultadoTarea2)
                                </div>
                                <div class="timeline-footer">
                                </div>
                            </div>
                        </div>
                        <!-- /.timeline-label -->
                        <div>
                            <i class="fas fa-clock bg-gray"></i>
                        </div>
                    </div>
                </div>
                <!-- /.col -->
            </div>
        }
    }
    else
    {
        <div class="callout callout-info">
            <p> Sin firmas a reactivar.</p>
        </div>
    }
}
else
{
    <div class="callout callout-info">
        <p>No se han encontrado registros.</p>
    </div>
}
