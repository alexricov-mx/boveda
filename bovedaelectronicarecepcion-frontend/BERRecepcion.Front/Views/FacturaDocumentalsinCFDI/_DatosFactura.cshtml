@model BERRecepcion.Front.Models.Dto.CopadeDto
@using Newtonsoft.Json
<div class="row datos-factura">
    <div class="col-12">
        <div class="callout callout-info">
            <div class="form-group row m-0">
                <h3 class="col-xl-4 col-lg-4 col-md-7 col-sm-12 card-title m-auto">
                    <i class="fas fa-file-invoice mr-2"></i>Prefactura
                </h3>
                <div class="col-xl-8 col-lg-8 col-md-5 col-sm-12 m-0">
                    <button class="btn btn-sm btn-outline-info float-right" id="btnDocumentoCopade" data-copadeid="@Model.CopadeID">
                        <i class="fas fa-eye mr-1"></i> Ver documento COPADE
                    </button>
                </div>
            </div>
            <hr />
            <dl class="row m-0">
                <dt class="col-sm-3">RFC Emisor:</dt>
                <dd class="col-sm-9">@Model.CreditorRfc</dd>
                <dt class="col-sm-3">Razón social:</dt>
                <dd class="col-sm-9">@Model.Creditor</dd>
                <dt class="col-sm-3">No. Acreedor:</dt>
                <dd class="col-sm-9">@Model.CreditorNumber</dd>
                <dt class="col-sm-3">Órdenes de Surtimiento:</dt>
                <dd class="col-sm-9">@Model.SapOrder</dd>
                <dt class="col-sm-3">Ejercicio:</dt>
                <dd class="col-sm-9">@Model.Exercise</dd>

            </dl>
        </div>
    </div>

    <div class="col-md-12">
        <div class="callout callout-info">
            <h5 class="mb-3">
                <i class="fas fa-file-contract mr-2"></i> Conceptos
            </h5>
            <div class="table-responsive">
                <table class="table table-striped table-hover m-0">
                    <thead>
                        <tr>
                            <th>Cantidad</th>
                            <th>Unidad</th>
                            <th>Valor unitario</th>
                            <th>Importe</th>
                            <th>Descripción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.vPreFactura.comprobante.conceptos)
                        {
                            <tr>
                                <td>@item.cantidad</td>
                                <td>@item.unidad</td>
                                <td>$@String.Format("{0:#,##0.#0}", Convert.ToDouble(item.valorUnitario))</td>
                                <td>$@String.Format("{0:#,##0.#0}", Convert.ToDouble(item.importe))</td>
                                <td>@item.descripcion</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (Model.vNotasCredito != null && Model.vNotasCredito.notaCredito != null && Model.vNotasCredito.notaCredito.Count() > 0)
    {
        <div class="col-md-12">
            <div class="callout callout-info">
                <h5 class="mb-3">
                    <i class="fas fa-upload mr-2"></i> Notas de crédito
                </h5>
                @foreach (var item in Model.vNotasCredito.notaCredito)
                {
                    <div class="table-responsive" name="div_notas_credito">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Tipo</th>
                                    <th>Concepto</th>
                                    <th>Cantidad</th>
                                    <th>Importe</th>
                                    <th>IVA</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{item.Id = @Guid.NewGuid();}
                                <tr>
                                    <td>@item.Tipo</td>
                                    <td name="nota-credito-descripcion" data-value="@item.Concepto">@item.Concepto</td>
                                    <td name="nota-credito-amount" data-value="@item.Cantidad">@item.Cantidad</td>
                                    <td name="nota-credito-subtotal" data-value="@item.Importe" >$@String.Format("{0:#,##0.#0}", Convert.ToDouble(item.Importe))</td>
                                    <td name="nota-credito-iva" data-value="@item.Iva">$@String.Format("{0:#,##0.#0}", Convert.ToDouble(item.Iva))</td>
                                    <td name="nota-credito-total" data-value="@item.Total">$@String.Format("{0:#,##0.#0}", Convert.ToDouble(item.Total))</td>
                                </tr>
                            </tbody>
                        </table>
                        <div class="row mt-1 mb-1 mr-0 ml-0">
                            <div class="col-md-2 col-sm-12">
                                <input type="text" class="form-control form-control-sm" name="nota-credito-serie" id="serie_@item.Id" autocomplete="off" placeholder="Serie" maxlength="10">
                            </div>
                            <div class="col-md-3 col-sm-12">
                                <input type="text" class="form-control form-control-sm" name="nota-credito-folio" id="folio_@item.Id" autocomplete="off" placeholder="Folio" maxlength="10">
                            </div>
                            <div class="col-md-3 col-sm-12">
                                <input type="date" class="form-control form-control-sm" max="@DateTime.Now.ToString("yyyy-MM-dd")" name="nota-credito-fecha" id="fecha_@item.Id" autocomplete="off" placeholder="Fecha">
                            </div>
                            <div class="col-md-4 col-sm-12">
                                <input type="text" class="form-control form-control-sm input-uuid" name="nota-credito-uuid" id="uuid_@item.Id" autocomplete="off" placeholder="UUID" maxlength="36">
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
<div class="row datos-factura">
    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12">
        <div class="callout callout-info">
            <h6 class="text-muted m-0 mr-1">
                Subtotal:
                <strong class="ml-1">$@String.Format("{0:#,##0.#0}", Convert.ToDouble(Model.vPreFactura.comprobante.subtotal))</strong>
            </h6>
        </div>
    </div>
    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12">
        <div class="callout callout-info">
            <h6 class="text-muted m-0 mr-1">
                Impuestos trasladados:
                <strong class="ml-1">$@String.Format("{0:#,##0.#0}", Convert.ToDouble(Model.vPreFactura.comprobante.impuestos?.totalImpuestosTrasladados))</strong>
            </h6>
        </div>
    </div>
    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12">
        <div class="callout callout-info">
            <h6 class="text-muted m-0 mr-1">
                Total:
                <strong class="ml-1" id="factura-Total">$@String.Format("{0:#,##0.#0}", Convert.ToDouble(Model.vPreFactura.comprobante.total))</strong>
            </h6>
        </div>
    </div>
    <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12">
        <div class="callout callout-info">
            <h6 class="text-muted m-0 mr-1">
                Moneda: <strong class="ml-1">@Model.vPreFactura.comprobante.moneda</strong>
            </h6>
        </div>
    </div>
</div>
<div class="row datos-factura">
    <div class="col-md-12">
        <div class="callout callout-info">
            <h5>
                <i class="fas fa-file-invoice mr-2"></i> Factura
            </h5>
            <hr />
            <dl class="row m-0">
                
                <dt class="col-xl-2 col-lg-2 col-md-3 col-sm-3">Serie</dt>
                <dd class="col-xl-4 col-lg-4 col-md-9 col-sm-9"><input type="text" class="form-control form-control-sm" id="factura-Serie" maxlength="10" /></dd>

                <dt class="col-xl-2 col-lg-2 col-md-3 col-sm-3">Folio:</dt>
                <dd class="col-xl-4 col-lg-4 col-md-9 col-sm-9"><input type="text" class="form-control form-control-sm" id="factura-Folio" maxlength="10" /></dd>

                <dt class="col-xl-2 col-lg-2 col-md-3 col-sm-3">Fecha factura:</dt>
                <dd class="col-xl-4 col-lg-4 col-md-9 col-sm-9"><input type="date" class="form-control form-control-sm" max="@DateTime.Now.ToString("yyyy-MM-dd")" id="factura-FechaFactura" /></dd>

                <dt class="col-xl-2 col-lg-2 col-md-3 col-sm-3">VU / Asignación:</dt>
                <dd class="col-xl-4 col-lg-4 col-md-9 col-sm-9"><input type="text" class="form-control form-control-sm" id="factura-Region" maxlength="15" /></dd>

                <dt class="col-xl-2 col-lg-2 col-md-3 col-sm-3">Total Factura:</dt>
                <dd class="col-xl-4 col-lg-4 col-md-9 col-sm-9">
                    <div class="input-group">
                        <div class="input-group input-group-sm">
                            <div class="input-group-prepend">
                                <span class="input-group-text">$</span>
                            </div>
                            <input type="text" class="form-control form-control-sm amount" id="factura-TotalFactura" />
                        </div>
                    </div>
                </dd>
                <dt class="col-xl-2 col-lg-2 col-md-3 col-sm-3">UUID:</dt>
                <dd class="col-xl-4 col-lg-4 col-md-9 col-sm-9"><input type="text" name="uuid" class="form-control form-control-sm input-uuid" id="factura-UUID" maxlength="36" /></dd>
            </dl>
            <dl class="row m-0">
                <dt class="col-xl-2 col-lg-2 col-md-3 col-sm-3">Correo:</dt>
                <dd class="col-xl-4 col-lg-4 col-md-9 col-sm-9"><input type="text" class="form-control form-control-sm" id="factura-Correo" maxlength="100" /></dd>
            </dl>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-12" id="validationErrorsFactura"></div>
</div>
<div class="row datos-factura">
    <div class="col-12">
        <button class="btn btn-sm btn-outline-success float-right" id="btnEnviarFactura" data-documentobeid="@Model.CopadeID" style="width:100px;">
            Enviar <i class="fas fa-chevron-right float-right mt-1"></i>
        </button>
        <button class="btn btn-sm btn-outline-info float-right mr-2" id="btnLimpiar" style="width:100px;">
            Limpiar <i class="fas fa-stamp float-right mt-1"></i>
        </button>
    </div>
</div>
