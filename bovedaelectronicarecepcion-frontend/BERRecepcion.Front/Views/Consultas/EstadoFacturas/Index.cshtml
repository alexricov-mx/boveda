@{
    DateTime? ConsultaFacturasFechaInicial = null;
    if (TempData["CFFechaInicial"] != null ) ConsultaFacturasFechaInicial = Convert.ToDateTime(TempData["CFFechaInicial"]);
    DateTime? ConsultaFacturasFechaFinal = null;
    if (TempData["CFFechaFinal"] != null ) ConsultaFacturasFechaFinal = Convert.ToDateTime(TempData["CFFechaFinal"]);
    string[] searchList = null;
    if (TempData["CFSearch"] != null) searchList = (string[])TempData["CFSearch"];
}

@{
    ViewData["Title"] = "Estado de Facturas";
}

<!-- Content Header (Page header) -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Estado de Facturas</h1>
            </div><!-- /.col -->
        </div><!-- /.row -->
    </div><!-- /.container-fluid -->
</div>
<!-- /.content-header -->


<section class="content">
    <div class="container-fluid">

        <div class="card-header">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <form id="estadofacturas-form-search">
                            <input type="hidden" id="isRedirectEstadoFacturas" value="@ViewBag.isRedirectEstadoFacturas" />
                            <div class="card-header">
                                <h5 class="mb-0 text-olive">
                                    <i class="fa fa-filter"></i> Filtro
                                    <button class="btn btn-sm btn-outline-success float-right" style="width:135px;display:none;" id="ExportExcelAll"><span class="fas fa-download"></span> Excel</button>
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="form-row">
                                    <div class="form-group col-md-3">
                                        <label class="col-form-label col-form-label-sm" for="FechaInicial">Fecha Inicial</label>
                                        @if (ConsultaFacturasFechaInicial != null)
                                        {
                                            <input type="date" class="form-control form-control-sm" id="fecha-inicial" max="@DateTime.Now.ToString("yyyy-MM-dd")" value="@ConsultaFacturasFechaInicial.Value.ToString("yyyy-MM-dd")">
                                        }
                                        else
                                        {
                                            <input type="date" class="form-control form-control-sm" id="fecha-inicial" max="@DateTime.Now.ToString("yyyy-MM-dd")">
                                        }
                                    </div>
                                    <div class="form-group col-md-3">
                                        <label class="col-form-label col-form-label-sm" for="FechaFinal">Fecha Final</label>
                                        @if (ConsultaFacturasFechaFinal != null)
                                        {
                                            <input type="date" class="form-control form-control-sm" id="fecha-final" max="@DateTime.Now.ToString("yyyy-MM-dd")" value="@ConsultaFacturasFechaFinal.Value.ToString("yyyy-MM-dd")">
                                        }
                                        else
                                        {
                                            <input type="date" class="form-control form-control-sm" id="fecha-final" max="@DateTime.Now.ToString("yyyy-MM-dd")">
                                        }
                                    </div>
                                    <div class="form-group col-md-5">
                                        <label class="col-form-label col-form-label-sm" for="Busqueda">Texto</label>
                                        <input type="text" class="form-control form-control-sm search" id="search" placeholder="Buscar" autocomplete="off">
                                    </div>
                                    <div class="form-group col-md-1">
                                        <label class="col-form-label col-form-label-sm" for="btnBuscar" style="visibility:hidden;">.</label>
                                        <button type="submit" class="btn btn-sm btn-default w-100" id="btnBuscar">
                                            <i class="fa fa-search"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="form-row ml-0" id="searchTerms">
                                    @if (searchList != null)
                                    {
                                        foreach (var item in searchList)
                                        {
                                            <span class="badge badge-pill border border-primary mr-1 mb-2">
                                                <span name="badgeTerms">@item</span><i class="fas fa-times ml-2" name="deleteTerm" style="cursor: pointer;"></i>
                                            </span>
                                        }

                                    }
                                </div>
                                <div class="col-12" id="estadofacturas-card">

                                </div>
                            </div>
                        </form>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <!-- /.container-fluid -->
</section>

@section scripts{
    <script type="text/javascript" src="@Url.Content("~/js/Consultas/EstadoFacturas/index.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/Consultas/search.js")"></script>
}


