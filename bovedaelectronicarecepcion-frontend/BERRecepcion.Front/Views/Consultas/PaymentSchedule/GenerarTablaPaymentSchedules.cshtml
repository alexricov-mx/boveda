@using BERRecepcion.Front.Models.Dto
@using Newtonsoft.Json
@model DataResult<IEnumerable<ReportePaymentScheduleDto>>

@{
    bool contieneRegistros = Model != null && Model.Data != null && Model.Data.Count() > 0;
}

@if (contieneRegistros)
{
    <table class="table table-hover" id="paymentschedule-table" style="font-size:14px;">
        <thead>
            <tr>

                <th>Organismo</th>
                <th>Consolidación ID</th>
                <th>Fecha Programa</th>
                <th>Fecha Pago</th>
                <th class="text-center">PDF</th>
                <th>Func. Status</th>
                @*<th class="text-center">PDF</th>
            <th>Organismo</th>
            <th>Programa Pago</th>
            <th>Fecha de Pago</th>
            <th>Fecha de Recepción</th>
            <th>Fecha Programada</th>*@
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Data)
            {
                <tr>
                    <td scope="row">@item.Organismo</td>
                    <td scope="row">@item.ConsolidacionID</td>
                    <td scope="row">@item.FechaPrograma</td>
                    <td scope="row">@item.FechaPago</td>
                    <td scope="row" class="text-center">
                        <i class="fas fa-file-pdf image-pdf pdf-red-color" data-id="@item.ProgramaPago_Id" onclick="pdfPreview('@item.ProgramaPago_Id','@item.Organismo')"></i>
                    </td>
                    <td scope="row" class="text-center"><span class="@(@item.FuncStatus ? "dot-active" : "dot")"></span></td>
                    @*<td scope="row">@item.Organismo</td>
            <td scope="row">@item.ProgramaPago_Id</td>
            <td scope="row">@item.PaymentDate</td>
            <td scope="row">@item.ReceptionDate</td>
            <td scope="row">@item.ScheduleDate</td>*@
                </tr>
            }
        </tbody>
    </table>
    <div class="row mt-2">
        <div class="col-12">
            <partial name="_Pagination" model="@Model.Pager" />
        </div>
    </div>
    <script>
        $(function () {
            DataTableInitialize("paymentschedule-table");
        });
    </script>
}
else
{
    <div class="callout callout-info">
        <p>No se ha encontrado información.</p>
    </div>
}
