@using BERRecepcion.Front.Models.Dto
@using Newtonsoft.Json
@model DataResult<IEnumerable<SupplyOrderDto>>
@{
    bool hasData = Model != null && Model.Data != null && Model.Data.Count() > 0;
}
@if (hasData)
{
    <table class="table table-hover" id="supply-order-consulta-table" style="font-size:14px;">
        <thead>
            <tr>
                <th class="text-center">Expediente</th>
                <th>Organismo</th>
                <th>Contrato</th>
                <th>No. de Pedido</th>
                <th>Moneda</th>
                <th>Nombre de Acreedor</th>
                <th class="text-right">Total</th>
                <th>Fecha de Recepción</th>
                <th>Orden SIAF</th>
                <th>Tipo</th>
                <th>Fecha Firma del Funcionario</th>
                <th>Fecha Firma del Proveedor</th>
                <th>Estatus</th>
                <th>Cancelado</th>
                @*<th class="text-center">Expediente</th>
            <th>OS</th>
            <th>Contrato</th>
            <th>Organismo</th>
            <th>Tipo</th>
            <th>Acreedor</th>
            <th class="text-right">Total</th>
            <th>Moneda</th>*@
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Data)
            {
                <tr>
                    <td class="text-center">
                        <i class="fas fa-folder" style="font-size:1.5em; cursor:pointer;" name="btnExpediente" data-saporder="@item.SAPOrder"></i>
                    </td>
                    <td scope="row">@item.OrganismClave</td>
                    <td scope="row">@item.Contract</td>
                    <td scope="row">@item.SAPOrder</td>
                    <td scope="row">@item.Currency</td>
                    <td scope="row">@item.Creditor</td>
                    <td scope="row" class="text-right">$@String.Format("{0:#,##0.#0}", Convert.ToDouble(@item.Total))</td>
                    <td scope="row">@item.ReceptionDate</td>
                    <td scope="row">@item.SIAFOrder</td>
                    <td scope="row">@item.DocumentType</td>
                    <td scope="row">@item.FunctionarySignDate</td>
                    <td scope="row">@item.ProviderSignDate</td>
                    <td scope="row">@(@item.FunctionarySignDate.HasValue && @item.ProviderSignDate.HasValue ? "Firmado" : (!@item.FunctionarySignDate.HasValue ? "Funcionario" : "Proveedor"))</td>
                    <td scope="row">@(@item.IsCancel.HasValue && @item.IsCancel.Value ? "SI" : "NO")</td>
                    @*<td class="text-center">
            <i class="fas fa-folder" style="font-size:1.5em; cursor:pointer;" name="btnExpediente" data-saporder="@item.SAPOrder"></i>
            </td>
            <td scope="row">@item.SAPOrder</td>
            <td scope="row">@item.Contract</td>
            <td scope="row">@item.OrganismClave</td>
            <td scope="row">@item.DocumentType</td>
            <td scope="row">@item.Creditor</td>
            <td scope="row" class="text-right">$@String.Format("{0:#,##0.#0}", Convert.ToDouble(item.Total))</td>
            <td scope="row">@item.Currency</td>*@
                </tr>
            }
        </tbody>
    </table>
    <div class="row mt-2">
        <div class="col-12">
            <partial name="_Pagination" model="@Model.Pager" />
        </div>
    </div>
    <script>
        $(function () {
            DataTableInitialize("supply-order-consulta-table");
        });
    </script>
}
else
{
    <div class="callout callout-info">
        <p>No se ha encontrado información.</p>
    </div>
}
<script>
    var _hasData = @(hasData ? "true" : "false");
</script>