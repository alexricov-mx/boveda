@using BERRecepcion.Front.Models.Dto
@using Newtonsoft.Json
@model DataResult<IEnumerable<CopadeDto>>

@{
    bool contieneCopades = Model != null && Model.Data != null && Model.Data.Count() > 0;
}



        @if (contieneCopades)
        {
            <table class="table table-hover" id="copade-table" style="font-size:14px;">
                <thead>
                    <tr>
                        <th class="text-center">PDF</th>
                        <th>COPADE</th>
                        <th>OS</th>
                        <th>Contrato</th>
                        <th>Organismo</th>
                        <th>Tipo</th>
                        <th>Centro</th>
                        <th>Fecha Recepcion</th>
                        <th>Ejercicio</th>
                        <th>Total</th>
                        <th>Firmante1</th>
                        <th>Firmante2</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Data)
                    {

                        <tr>
                            <td scope="row" class="text-center">
                                <i class="fas fa-file-pdf image-pdf pdf-red-color" data-id="@item.CopadeID" onclick="pdfPreview('@item.clave', '@item.SapOrder', '@item.Reception', '@item.Exercise', '@item.Functionary1SignDate', '@item.CopadeID')"></i>
                            </td>
                            <td scope="row">@item.Reception</td>
                            <td scope="row">@item.SapOrder</td>
                            <td scope="row">@item.Contract</td>
                            <td scope="row">@item.clave</td>
                            <td scope="row">@item.DocumentType</td>
                            <td scope="row">@item.Center</td>
                            @*<td scope="row">@item.ReceptionDate.ToString("dd/MM/yyyy hh:mm")</td>*@
                    <td scope="row">@string.IsNullOrWhiteSpace(item.ReceptionDate.ToString()) ? "" : item.ReceptionDate.ToString("dd/MM/yyyy hh:mm"))</td>
                            <td scope="row">@item.Exercise</td>
                            <td scope="row">$@item.Total</td>

                            <td scope="row" class="text-center"><span class="@(string.IsNullOrWhiteSpace(item.Functionary1SignDate.ToString()) ? "dot" : "dot-active")"></span></td>
                            <td scope="row" class="text-center"><span class="@(string.IsNullOrWhiteSpace(item.Functionary2SignDate.ToString()) ? "dot" : "dot-active")"></span></td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="row mt-2">
                <div class="col-12">
                    <partial name="_Pagination" model="@Model.Pager" />
                </div>
            </div>
            <script>
                $(function () {
                    DataTableInitialize("copade-table");
                });
            </script>
        }
        else
        {
            <div class="callout callout-info">
                <p>No tiene Copades.</p>
            </div>
        }

