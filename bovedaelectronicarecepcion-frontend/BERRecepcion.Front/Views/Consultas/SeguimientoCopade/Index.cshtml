@{ 
    DateTime? FechaInicial = ViewBag.FechaInicial;
    DateTime? FechaFinal = ViewBag.FechaFinal;
}
@{
    ViewData["Title"] = "Seguimiento de Copade";
}
<!-- Content Header (Page header) -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <h3 class="m-0">Seguimiento de Copade</h3>
            </div><!-- /.col -->
        </div><!-- /.row -->
    </div><!-- /.container-fluid -->
</div>
<!-- /.content-header -->
<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <button class="btn btn-sm btn-outline-success float-right" style="width:135px;" id="btnExcel"><span class="fas fa-download"></span> Excel</button>
                    </div>
                    <div class="card-body">
                        <form id="consulta-form-search">
                            <div class="form-row">
                                <div class="form-group col-md-3">
                                    <label class="col-form-label col-form-label-sm" for="FechaInicial">Fecha Inicial</label>
                                    @if (FechaInicial != null)
                                    {
                                        <input type="date" class="form-control form-control-sm" id="FechaInicial" value="@FechaInicial.Value.ToString("yyyy-MM-dd")">
                                    }
                                    else
                                    {
                                        <input type="date" class="form-control form-control-sm" id="FechaInicial">
                                    }
                                </div>
                                <div class="form-group col-md-3">
                                    <label class="col-form-label col-form-label-sm" for="FechaFinal">Fecha Final</label>
                                    @if (FechaFinal != null)
                                    {
                                        <input type="date" class="form-control form-control-sm" id="FechaFinal" value="@FechaFinal.Value.ToString("yyyy-MM-dd")">
                                    }
                                    else
                                    {
                                        <input type="date" class="form-control form-control-sm" id="FechaFinal">
                                    }
                                </div>
                                <div class="form-group col-md-5">
                                    <label class="col-form-label col-form-label-sm" for="search">Texto</label>
                                    <input type="text" class="form-control form-control-sm search" id="search" placeholder="Opcional" maxlength="50" autocomplete="off">
                                </div>
                                <div class="form-group col-md-1">
                                    <label class="col-form-label col-form-label-sm" for="btnBuscar" style="visibility:hidden;">.</label>
                                    <button type="submit" class="btn btn-sm btn-default w-100" id="btnBuscar">
                                        <i class="fa fa-search"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="form-row ml-0" id="searchTerms">
                                @if (ViewBag.Search != null && ViewBag.Search.Count > 0)
                                {
                                    foreach (var item in ViewBag.Search)
                                    {
                                        <span class="badge badge-pill border border-primary mr-1 mb-2">
                                            <span name="badgeTerms">@item</span><i class="fas fa-times ml-2" name="deleteTerm" style="cursor: pointer;"></i>
                                        </span>
                                    }
                                }
                            </div>
                        </form>
                        <div id="ConsultaCopadetable">

                        </div>
                    </div>
                </div>

            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </div>
    <!-- /.container-fluid -->
</section>

@section scripts{
    <script type="text/javascript" src="@Url.Content("~/js/Consultas/SeguimientoCopade/index.js")"></script>
    <script type="text/javascript" src="@Url.Content("~/js/Consultas/search.js")"></script>
}




