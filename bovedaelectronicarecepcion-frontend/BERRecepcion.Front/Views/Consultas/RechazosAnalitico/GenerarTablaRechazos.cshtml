@using BERRecepcion.Front.Models.Dto
@using Newtonsoft.Json
@model DataResult<IEnumerable<ReporteRechazosDto>>

@{
    bool contieneRechazos = Model != null && Model.Data != null && Model.Data.Count() > 0;
}


        @if (contieneRechazos)
        {
            <table class="table table-hover" id="rechazos-table" style="font-size:14px;">
                <thead>
                    <tr>
                        <th>Documento</th>
                        <th>RFC Acreedor</th>
                        <th>Razon Social</th>
                        <th>RFC Receptor</th>
                        <th>Organismo</th>
                        <th>Fecha Rechazo</th>
                        <th>Correo</th>
                        <th>Motivo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Data)
                    {

                        <tr>
                            <td scope="row">@item.Documento</td>
                            <td scope="row">@item.RFCAcreedor</td>
                            <td scope="row">@item.RazonSocial</td>
                            <td scope="row">@item.RFCReceptor</td>
                            <td scope="row">@item.Organismo</td>
                            <td scope="row">@item.FechaRechazo.ToString("dd/MM/yyyy hh:mm")</td>
                            <td scope="row">@item.Correo</td>
                            <td scope="row">
                                <ul>
                                    @foreach (var it in item.MotivoRechazo)
                                    {
                                        <li>@it</li>
                                    }
                                </ul>
                            </td>
                        </tr>
                    }
                </tbody>                
            </table>
            <div class="row mt-2">
                <div class="col-12">
                    <partial name="_Pagination" model="@Model.Pager" />
                </div>
            </div>
            <script>
                $(function () {
                    DataTableInitialize("rechazos-table");
                });
            </script>
        }
        else
        {
            <div class="callout callout-info">
                <p>No se encontraron rechazos.</p>
            </div>
        }
