@using BERRecepcion.Front.Models.Dto
@using Newtonsoft.Json
@model DataResult<IEnumerable<ReportePaymentListDto>>

@{
    bool contieneRegistros = Model != null && Model.Data != null && Model.Data.Count() > 0;
}

        @if (contieneRegistros)
        {
            <table class="table table-hover" id="paymentlist-table" style="font-size:14px;">
                <thead>
                    <tr>
                        <th class="text-center">PDF</th>
                        <th>Organismo</th>
                        <th>Lista de Pago</th>
                        <th>Fecha</th>
                        <th>Fecha de Recepción</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Data)
                    {

                        <tr>
                            <td scope="row" class="text-center">
                                <i class="fas fa-file-pdf image-pdf pdf-red-color" data-id="@item.ListaPago_Id" onclick="pdfPreview('@item.ListaPago_Id')"></i>
                            </td>
                            <td scope="row">@item.Organismo</td>
                            <td scope="row">@item.ListaPago_Id</td>
                            <td scope="row">@item.Date</td>
                            <td scope="row">@item.ReceptionDate</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="row mt-2">
                <div class="col-12">
                    <partial name="_Pagination" model="@Model.Pager" />
                </div>
            </div>
            <script>
                $(function () {
                    DataTableInitialize("paymentlist-table");
                });
            </script>
        }
        else
        {
            <div class="callout callout-info">
                <p>No se ha encontrado información.</p>
            </div>
        }
