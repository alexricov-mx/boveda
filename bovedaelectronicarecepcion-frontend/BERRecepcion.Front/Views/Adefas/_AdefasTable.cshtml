@using BERRecepcion.Front.Models.Dto
@using Newtonsoft.Json
@model DataResult<IEnumerable<AdefasDto>>

@if (Model != null && Model.Data != null && Model.Data.Count() > 0)
{
    <table class="table table-hover" id="adefas-table" style="font-size:14px;">
        <thead>
            <tr>
                <th></th>
                <th>Organismo</th>
                <th>Año Factura</th>
                <th>Inicio de Ventana</th>
                <th>Fin de Ventana</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Data)
            {
                <tr>
                    <td scope="row" class="text-center">
                        <span class="info-box-text text-wrap">
                            <small>
                                <button type="button" class="btn btn-sm btn-outline-secondary float-right" data-toggle="dropdown">
                                    <span class="fas fa-cog">
                                    </span>
                                </button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <button class="dropdown-item text-muted text-info w-100" name="edit" data-adefaid="@item.AdefaID">Editar</button>
                                    </li>
                                    <li>
                                        <button class="dropdown-item text-muted text-danger w-100" name="delete" style="cursor:pointer;" data-adefaid="@item.AdefaID">Eliminar</button>
                                    </li>
                                </ul>
                            </small>
                        </span>
                    </td>
                    <td scope="row">@item.OrganismClave</td>
                    <td scope="row">@item.AnhioFactura</td>
                    <td scope="row">@item.InicioVentana</td>
                    <td scope="row">@item.FinVentana</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="row mt-2">
        <div class="col-12">
            <partial name="_Pagination" model="@Model.Pager" />
        </div>
    </div>
    <script>
        $(function () {
            DataTableInitialize("adefas-table");
        });
    </script>
}
else
{
    <div class="callout callout-info">
        <p>No se ha encontrado información.</p>
    </div>
}