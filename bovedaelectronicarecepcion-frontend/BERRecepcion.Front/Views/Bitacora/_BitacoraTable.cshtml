@using BERRecepcion.Front.Models.Dto
@model DataResult<IEnumerable<BitacoraDto>>

@if (Model.Data != null && Model.Data.Count() > 0)
{
    <table class="table table-striped table-hover" id="bitacora-table">
        <thead>
            <tr>
                <th scope="row">Usuario</th>
                <th scope="row">Sección</th>
                <th scope="row">Acción</th>
                <th scope="row">Descripción</th>
                <th scope="row">Fecha</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Data)
            {
                <tr>
                    <td scope="row">@item.UserName</td>
                    <td scope="row">@item.Seccion</td>
                    <td scope="row">@item.Accion</td>
                    <td scope="row">@item.Descripcion</td>
                    <td scope="row">@item.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="row mt-2">
        <div class="col-12">
            <partial name="_Pagination" model="@Model.Pager" />
        </div>
    </div>
    <script>
        $(function () {
            DataTableInitialize("bitacora-table");
        });
    </script>
}
else
{
    <div class="callout callout-info">
        <p>No se encontraron resultados.</p>
    </div>
}
