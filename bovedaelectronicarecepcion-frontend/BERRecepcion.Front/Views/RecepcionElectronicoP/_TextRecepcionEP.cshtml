    <div class="col-md-12">
        <div class="callout callout-info">
            <h5 class="mb-3">
                <i class="fas fa-file-contract mr-2"></i> Conceptos
            </h5>
            <div class="table-responsive">
                <table class="table table-striped table-hover m-0">
                    <thead>
                        <tr>
                            <th>Clave</th>
                            <th>Cantidad</th>
                            <th>Unidad de Medida</th>
                            <th>Descripción</th>
                            <th>Precio Unitario</th>
                            <th>Importe</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.comprobante.Conceptos.Concepto)
                        {
                            <tr>
                                <td>@item.ClaveProdServ</td>
                                <td>@item.Cantidad</td>
                                <td>@item.ClaveUnidad</td>
                                <td>@item.Descripcion</td>
                                <td>$@String.Format("{0:#,##0.#0}", Convert.ToDouble(item.ValorUnitario))</td>
                                <td>$@String.Format("{0:#,##0.#0}", Convert.ToDouble(item.Importe))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-12">
        <div class="callout callout-info">
            <h5 class="mb-3">
                <i class="fas fa-file-invoice-dollar mr-2"></i> Información de Recepción de Pagos
            </h5>
            <div class="table-responsive">
                <table class="table table-striped table-hover m-0">
                    <thead>
                        <tr>
                            <th>Fecha de Pago</th>
                            <th>Forma de Pago</th>
                            <th>Moneda</th>
                            <th>Tipo de Cambio</th>
                            <th>Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@(Convert.ToDateTime(Model.comprobante.Complemento.Pagos.Pago.FechaPago).ToString("dd/MM/yyyy"))  </td>
                            <td>@Model.comprobante.Complemento.Pagos.Pago.FormaDePagoP</td>
                            <td>@Model.comprobante.Complemento.Pagos.Pago.MonedaP</td>
                            <td></td>
                            <td>$@String.Format("{0:#,##0.#0}", Convert.ToDouble(@Model.comprobante.Complemento.Pagos.Pago.Monto))</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row datos-factura">
    <div class="col-xl-12 col-lg-3 col-md-6 col-sm-12">
        <div class="callout callout-info">
            <h6 class="text-muted m-0">UUID: <strong class="ml-1">@Model.comprobante.Complemento.TimbreFiscalDigital.UUID.ToString().ToUpper()</strong></h6>
        </div>
    </div>
</div>



<div class="row datos-factura">
    <div class="col-md-12">
        <div class="callout callout-info">
            <h5 class="mb-3">
                <i class="fas fa-file-contract mr-2"></i> Documentos Relacionados
            </h5>
            <div class="table-responsive">
                <table class="table table-striped table-hover m-0">
                    <thead>
                        <tr>
                            <th>Existe Documento</th>
                            <th>ID Documento</th>
                            <th>Cantidad</th>
                            <th>Unidad de Medida</th>
                            <th>Descripción</th>
                            <th>Precio Unitario</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.comprobante.Complemento.Pagos.Pago.DoctoRelacionado)
                        {
                        <tr>
                            
                            <td>
                                <center>
                                    <i class="fas @(item.ExisteEnBD == true? "fa-check-circle " :"fa-times-circle" )" style="font-size: 1.8em; color: @(item.ExisteEnBD == true? "seagreen" :"red" );">
                                    </i>
                                </center>
                            </td>
                            

                            <td>@item.IdDocumento</td>
                            <td>@item.MonedaDR</td>
                            <td>@item.MetodoDePagoDR</td>
                            <td>@item.Folio</td>
                            <td>@item.Folio</td>

                            @*<td class=" @(item.ExisteEnBD == true? "bg-green" :"bg-danger" )">@item.IdDocumento</td>
        <td class=" @(item.ExisteEnBD == true? "bg-green" :"bg-danger" )">@item.MonedaDR</td>
        <td class=" @(item.ExisteEnBD == true? "bg-green" :"bg-danger" )">@item.MetodoDePagoDR</td>
        <td class=" @(item.ExisteEnBD == true? "bg-green" :"bg-danger" )">@item.Folio</td>
        <td class=" @(item.ExisteEnBD == true? "bg-green" :"bg-danger" )">@item.Folio</td>*@
                        </tr>
                        }
                    </tbody>
                </table>
                @*<span id="progress_status" _ data-notaid="" class="badge badge-success notaInfo">Validada</span>
                <span id="progress_status2" class="badge badge-warning">Pendiente</span>
                <i class="fas fa-times-circle" style="font-size: 1.8em; color: red;" name="test""></i>
                <i class="fas " style="font-size: 1.8em; color: seagreen;" name="notaCredito"></i>
                <i class="fad fa-times-circle" style="font-size: 1.8em; color: seagreen;" name="notaCredito2"></i>*@
            </div>
        </div>
    </div>
</div>

<div class="row datos-factura">
    <div class="col-12">
        <button class="btn btn-sm btn-outline-success float-right" id="btnEnviarFactura" style="width:135px;">
            Recibir <i class="fas fa-chevron-right ml-1"></i>
        </button>
        <button class="btn btn-sm btn-outline-info float-right mr-2" id="btnLimpiar" style="width:135px;">
            Limpiar <i class="fas fa-stamp ml-1"></i>
        </button>
    </div>
</div>