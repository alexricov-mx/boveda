@model BERRecepcion.Front.Models.Dto.UsersDto
@{
    ViewData["Title"] = "Recepción de Factura Electrónica COPADE";
}

<!-- Content Header (Page header) -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-12">
                <h3 class="m-0">Recepción Electronico de Pagos</h3>
            </div><!-- /.col -->
        </div><!-- /.row -->
    </div><!-- /.container-fluid -->
</div>
<!-- /.content-header -->
<!-- Main content -->
<section class="content">
    <div class="container-fluid">

        <div class="col-12">
            <div class="card card-outline card-olive">
                <div class="card-header">
                    <div class="form-group row m-0">
                        <h3 class="col-xl-6 col-lg-6 col-md-7 col-sm-12 card-title m-auto text-muted">
                            <i class="fas fa-upload mr-2"></i> Por favor suba el archivo XML:
                        </h3>
                        <div class="col-xl-6 col-lg-6 col-md-5 col-sm-12">
                            <button class="btn btn-sm btn-outline-success float-right d-none" id="btnValidarFactura">
                                <i class="fas fa-check mr-1"></i><span>Validar</span>
                            </button>
                            <button class="btn btn-sm btn-outline-info float-right mr-2" id="btnFactura">
                                <i class="fas fa-file-upload mr-1"></i><span id="file-name">seleccionar archivo</span>
                            </button>
                            <input type="file" id="fileFactura" accept=".xml" class="d-none">
                        </div>
                    </div>
                </div>

            </div>
        </div>



        <div class="col-12">
            <!-- Datos generales -->
            <div class="card card-outline card-olive">
                <div class="card-header">
                    <h4 class="card-title">
                        <i class="fas fa-info mr-2"></i>Datos generales EMISOR
                    </h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12">
                            <div class="callout callout-info">
                                <h6 class="text-muted m-0 mr-1">
                                    RFC: <strong class="ml-1">@Model.CreditorRFC</strong>
                                </h6>
                            </div>
                        </div>
                        <div class="col-xl-6 col-lg-12 col-md-12 col-sm-12">
                            <div class="callout callout-info">
                                <h6 class="text-muted m-0 mr-1">
                                    Factura expedida a favor de: <strong class="ml-1">@Model.Company</strong>
                                </h6>
                            </div>
                        </div>
                    </div>
                </div>
                @*<div class="card-body">
                    <div id="div-text-addenda"></div>
                </div>*@
            </div>
            <div class="card card-outline card-olive">
                <div class="card-header">
                    <h4 class="card-title">
                        <i class="fas fa-info mr-2"></i>Datos generales RECEPTOR
                    </h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12">
                            <div class="callout callout-info">
                                <h6 class="text-muted m-0 mr-1">
                                    RFC: <strong class="ml-1">@Model.Organisms.FirstOrDefault().Clave</strong>
                                </h6>
                            </div>
                        </div>
                        <div class="col-xl-3 col-lg-6 col-md-6 col-sm-12">
                            <div class="callout callout-info">
                                <h6 class="text-muted m-0 mr-1">
                                    RFC: <strong class="ml-1">@Model.Organisms.FirstOrDefault().Rfc</strong>
                                </h6>
                            </div>
                        </div>
                        <div class="col-xl-6 col-lg-12 col-md-12 col-sm-12">
                            <div class="callout callout-info">
                                <h6 class="text-muted m-0 mr-1">
                                    Factura expedida a favor de: <strong class="ml-1">@Model.Organisms.FirstOrDefault().Name</strong>
                                </h6>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div id="div-text-addenda"></div>
                </div>
            </div>
        </div>

    </div>
</section>

@section scripts{
    <script type="text/javascript" src="@Url.Content("~/js/RecepcionElectronicoP/index.js")"></script>
}

<partial name="_ModalDocumentoPDF" />