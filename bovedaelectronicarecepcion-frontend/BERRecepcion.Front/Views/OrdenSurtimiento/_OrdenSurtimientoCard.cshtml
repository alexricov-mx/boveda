@using BERRecepcion.Front.Models.Dto
@using Newtonsoft.Json
@model DataResult<IEnumerable<SupplyOrderDto>>

@{
    bool contieneOrdenes = Model != null && Model.Data != null && Model.Data.Count() > 0;
}
<div class="card">
    <div class="card-header">
        <div class="row">
            <div class="col-md-8">
                @if (contieneOrdenes)
                {
                    <h6>Información de la orden de surtimiento</h6>
                    <small>Seleccione el documento a firmar</small>
                }
            </div>
            <div class="col-md-4">
                <form id="supply-orders-form-search">
                    <div class="input-group">
                        <input type="search" class="form-control form-control-sm" autocomplete="off" placeholder="Búsqueda de órdenes de surtimiento" value="@ViewBag.Search" id="search">
                        <div class="input-group-append">
                            <button type="submit" class="btn btn-sm btn-default">
                                <i class="fa fa-search"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="card-body">
        @if (contieneOrdenes)
        {
            <table class="table table-hover" id="supply-order-table" style="font-size:14px;">
                <thead>
                    <tr>
                        <th class="text-center">PDF</th>
                        <th></th>
                        <th>OS</th>
                        <th>Contrato</th>
                        <th>Organismo</th>
                        <th>Tipo</th>
                        <th style="max-width:40px;">Acreedor</th>
                        <th class="text-right">Total</th>
                        <th>Moneda</th>
                        <th class="text-center">Func. Status</th>
                        <th class="text-center">Liberación VP</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Data)
                    {
                        <tr>
                            <td scope="row" class="text-center">
                                <i class="fas fa-file-pdf image-pdf pdf-red-color" data-id="@item.SupplyOrderID" data-sapOrder="@item.SAPOrder" data-organismClave="@item.OrganismClave" data-functionarysigndate="@item.FunctionarySignDate"></i>
                            </td>
                            <td scope="row" class="text-center">
                                @{
                                    var _model = new Dictionary<string, object>
                                        {
                                            {"ItemID", item.SupplyOrderID }, //Obligatorio para estandarizar ID's
                                            {"Descripcion", string.Concat(item.SAPOrder, " - ", item.Contract) },
                                            {"SupplyOrderID", item.SupplyOrderID },
                                            {"SAPOrder", item.SAPOrder },
                                            {"Contract", item.Contract },
                                            {"OrganismClave", item.OrganismClave },
                                            {"Type", item.Type },
                                            {"FunctionarySignDate", item.FunctionarySignDate },
                                            {"CreditorNumber", item.CreditorNumber }
                                        };
                                }
                                <div class="custom-control custom-checkbox">
                                    <input class="custom-control-input custom-control-input-danger custom-control-input-outline" type="checkbox" name="checkPDF" id="@item.SupplyOrderID" @((ViewBag.PDFCheckDisabled == null || ViewBag.PDFCheckDisabled) ? "disabled" : "") data-model="@JsonConvert.SerializeObject(_model)" />
                                    <label class="custom-control-label" for="@item.SupplyOrderID"></label>
                                </div>
                            </td>
                            <td scope="row">@item.SAPOrder</td>
                            <td scope="row">@item.Contract</td>
                            <td scope="row">@item.OrganismClave</td>
                            <td scope="row">@item.DocumentType</td>
                            <td scope="row">@item.Creditor</td>
                            <td scope="row" class="text-right">$@String.Format("{0:#,##0.#0}", Convert.ToDouble(item.Total))</td>
                            <td scope="row">@item.Currency</td>
                            <td scope="row" class="text-center"><span class="@(string.IsNullOrWhiteSpace(item.FunctionarySignDate.ToString()) ? "dot" : "dot-active")"></span></td>

                            <td scope="row" class="text-center"><span class="@((string.IsNullOrWhiteSpace(item.LiberacionVPDate.ToString())) ? "dot" : "dot-active")"></span></td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="row mt-2">
                <div class="col-12 col-sm-3 col-md-2 col-lg-2 col-xl-2 mt-1 mb-2">
                    <button class="btn btn-sm btn-outline-success w-100" onclick="validarInfo(event);" style="width:100px;">
                        Firmar<i class="fas fa-pencil-alt float-right mt-1"></i>
                    </button>
                </div>
                <div class="col-12 col-sm-9 col-md-10 col-lg-10 col-xl-10">
                    <partial name="_Pagination" model="@Model.Pager" />
                </div>
            </div>
            <script>
                $(function () {
                    DataTableInitialize("supply-order-table");
                });
            </script>
        }
        else
        {
            <div class="callout callout-info">
                <p>No se han encontrado órdenes de surtimiento.</p>
            </div>
        }
    </div>
    <!-- /.card-body -->
</div>