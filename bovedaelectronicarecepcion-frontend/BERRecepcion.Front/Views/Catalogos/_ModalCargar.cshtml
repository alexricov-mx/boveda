<div class="modal fade" id="modalCargar" tabindex="-1" role="dialog" aria-labelledby="myModalLabelAgre" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" id="modal-content">
            <form id="formCatalogo" enctype="multipart/form-data" method="post" asp-controller="Catalogos" asp-action="Cargar">
                <div class="modal-header">
                    <h4 class="modal-title" id="modal-title">Cargar Catálogos Carta Porte</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body">
                    <div class="row">
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12">
                            <div class="form-group">
                                <label for="formFile" class="col-form-label">Archivo Excel (xls)</label>
                                <input id="formFile" name="formFile" type="file" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12">
                            <div class="progress">
                                <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>
                    </div>
                    @*<div class="row">
                        <div class="col-12 col-sm-12 col-md-12 col-lg-12 col-xl-12">
                            <div id="barResult" class="alert mt-2" role="alert"></div>
                        </div>
                    </div>*@
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-outline-danger" data-dismiss="modal" style="width:135px;">
                        <i class="fas fa-times mr-2"></i> Cerrar
                    </button>
                    <button type="submit" class="btn btn-sm btn-outline-success" style="width:135px;">
                        <i class="fas fa-upload mr-2"></i> Cargar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>