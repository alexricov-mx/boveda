@{
    ViewData["Title"] = "Ver Logs";
    Layout = null;
    var origen = ViewBag.Origen ?? "frontend";
    var origenLabel = ViewBag.OrigenLabel ?? "Frontend";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BER</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        body { padding: 20px; background-color: #f5f5f5; }
        pre { 
            background-color: #1e1e1e; 
            color: #d4d4d4; 
            padding: 20px; 
            border-radius: 5px; 
            max-height: 70vh; 
            overflow-y: auto; 
            font-size: 11px; 
            line-height: 1.4;
            white-space: pre-wrap;
            word-wrap: break-word;
        }
        .error-line { background-color: #5a1f1f; }
        .warning-line { background-color: #5a4f1f; }
        .search-highlight { background-color: yellow; color: black; }
        .origen-selector {
            border-radius: 20px;
            padding: 5px;
            background-color: #e9ecef;
        }
        .origen-selector .btn {
            border-radius: 15px;
            min-width: 120px;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="card shadow">
            <div class="card-header bg-dark text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="mb-0"><i class="fas fa-file-code"></i> Visualizador de Logs - @origenLabel</h4>
                    </div>
                    <a href="@Url.Action("Index", "Diagnostico")" class="btn btn-sm btn-light">
                        <i class="fas fa-arrow-left"></i> Volver a Diagnóstico
                    </a>
                </div>
            </div>
            <div class="card-body">
                <!-- Selector de Origen de Logs -->
                <div class="mb-3 text-center">
                    <div class="btn-group origen-selector" role="group" aria-label="Selector de origen de logs">
                        <a href="@Url.Action("VerLogs", new { origen = "frontend" })" 
                           class="btn @(origen == "frontend" ? "btn-primary" : "btn-outline-primary")">
                            <i class="fas fa-desktop"></i> Frontend
                        </a>
                        <a href="@Url.Action("VerLogs", new { origen = "backend" })" 
                           class="btn @(origen == "backend" ? "btn-success" : "btn-outline-success")">
                            <i class="fas fa-server"></i> Backend (API)
                        </a>
                    </div>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle"></i> <strong>Error:</strong> @ViewBag.Error
                        @if (ViewBag.LogsPath != null)
                        {
                            <br /><small>Ruta buscada: @ViewBag.LogsPath</small>
                        }
                    </div>
                    <div class="text-center">
                        <a href="@Url.Action("VerLogs", new { origen = origen == "backend" ? "frontend" : "backend" })" 
                           class="btn btn-outline-primary">
                            <i class="fas fa-exchange-alt"></i> Cambiar a @(origen == "backend" ? "Frontend" : "Backend")
                        </a>
                        <a href="@Url.Action("Index", "Diagnostico")" class="btn btn-primary">
                            <i class="fas fa-arrow-left"></i> Volver
                        </a>
                    </div>
                }
                else
                {
                    <div class="row mb-3">
                        <div class="col-md-8">
                            <div class="alert alert-info mb-0">
                                <strong><i class="fas fa-file-alt"></i> Archivo:</strong> @ViewBag.FileName
                                <span class="ms-3"><strong>Tamaño:</strong> @ViewBag.FileSize</span>
                                <span class="ms-3"><strong>Modificado:</strong> @ViewBag.LastModified</span>
                                <br/>
                                <small>Mostrando últimas <strong>@ViewBag.ShowingLines</strong> de <strong>@ViewBag.TotalLines</strong> líneas</small>
                                @if (ViewBag.LogsPath != null)
                                {
                                    <br /><small class="text-muted">Ruta: @ViewBag.LogsPath</small>
                                }
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="input-group">
                                <input type="text" 
                                       id="searchInput" 
                                       class="form-control" 
                                       placeholder="Buscar..." 
                                       onkeyup="searchInLogs()" />
                                <button class="btn btn-secondary" onclick="clearSearch()">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                            <small id="searchResults" class="text-muted"></small>
                        </div>
                    </div>

                    <!-- Mostrar lista de archivos disponibles si hay más de uno -->
                    @if (ViewBag.LogFiles != null && ViewBag.LogFiles.Count > 1)
                    {
                        <div class="mb-3">
                            <div class="card">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0">
                                        <i class="fas fa-folder-open"></i> Archivos de Log Disponibles (@ViewBag.LogFiles.Count)
                                        <button class="btn btn-sm btn-link float-end" type="button" data-bs-toggle="collapse" data-bs-target="#logFilesList">
                                            <i class="fas fa-chevron-down"></i>
                                        </button>
                                    </h6>
                                </div>
                                <div class="collapse" id="logFilesList">
                                    <div class="card-body">
                                        <div class="list-group">
                                            @foreach (var logFile in ViewBag.LogFiles)
                                            {
                                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <i class="fas fa-file-alt"></i> <strong>@logFile.Name</strong>
                                                        <br />
                                                        <small class="text-muted">@logFile.LastModified - @logFile.Size</small>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <div class="btn-group" role="group">
                            <button class="btn btn-sm btn-outline-danger" onclick="filterByLevel('Error')">
                                <i class="fas fa-times-circle"></i> Solo Errores
                            </button>
                            <button class="btn btn-sm btn-outline-warning" onclick="filterByLevel('Warning')">
                                <i class="fas fa-exclamation-triangle"></i> Solo Warnings
                            </button>
                            <button class="btn btn-sm btn-outline-info" onclick="filterByLevel('Information')">
                                <i class="fas fa-info-circle"></i> Solo Info
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" onclick="clearFilter()">
                                <i class="fas fa-list"></i> Ver Todo
                            </button>
                        </div>
                        
                        <div class="btn-group ms-3" role="group">
                            <button class="btn btn-sm btn-primary" onclick="copyToClipboard()">
                                <i class="fas fa-copy"></i> Copiar
                            </button>
                            <a href="@Url.Action("Index", "Logs")" class="btn btn-sm btn-success">
                                <i class="fas fa-download"></i> Descargar
                            </a>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-body p-0">
                            <pre id="logContent">@foreach (var line in ViewBag.LogContent)
{<text>@line
</text>}</pre>
                        </div>
                    </div>

                    <div class="mt-3">
                        <div class="alert alert-secondary">
                            <strong><i class="fas fa-search"></i> Buscar términos clave:</strong>
                            <div class="mt-2">
                                <button class="btn btn-sm btn-outline-danger me-2" onclick="quickSearch('Error')">Error</button>
                                <button class="btn btn-sm btn-outline-warning me-2" onclick="quickSearch('Warning')">Warning</button>
                                <button class="btn btn-sm btn-outline-info me-2" onclick="quickSearch('Data Protection')">Data Protection</button>
                                <button class="btn btn-sm btn-outline-primary me-2" onclick="quickSearch('AADSTS')">AADSTS</button>
                                <button class="btn btn-sm btn-outline-secondary me-2" onclick="quickSearch('message.State')">message.State</button>
                                <button class="btn btn-sm btn-outline-success me-2" onclick="quickSearch('autenticado correctamente')">Autenticación OK</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <script>
        let originalContent = document.getElementById('logContent')?.textContent || '';
        
        function searchInLogs() {
            const searchText = document.getElementById('searchInput').value;
            const logContent = document.getElementById('logContent');
            
            if (!searchText) {
                logContent.textContent = originalContent;
                document.getElementById('searchResults').textContent = '';
                return;
            }

            const lines = originalContent.split('\n');
            let matchCount = 0;
            let highlightedContent = '';

            lines.forEach(line => {
                if (line.toLowerCase().includes(searchText.toLowerCase())) {
                    matchCount++;
                    const regex = new RegExp(`(${escapeRegExp(searchText)})`, 'gi');
                    highlightedContent += line.replace(regex, '<mark class="search-highlight">$1</mark>') + '\n';
                } else {
                    highlightedContent += line + '\n';
                }
            });

            logContent.innerHTML = highlightedContent;
            document.getElementById('searchResults').textContent = 
                matchCount > 0 ? `${matchCount} coincidencia(s)` : 'Sin resultados';
        }

        function quickSearch(term) {
            document.getElementById('searchInput').value = term;
            searchInLogs();
        }

        function clearSearch() {
            document.getElementById('searchInput').value = '';
            searchInLogs();
        }

        function filterByLevel(level) {
            const logContent = document.getElementById('logContent');
            const lines = originalContent.split('\n');
            const filtered = lines.filter(line => line.includes(`[${level}]`));
            
            logContent.textContent = filtered.join('\n');
            document.getElementById('searchResults').textContent = `Mostrando ${filtered.length} líneas con [${level}]`;
        }

        function clearFilter() {
            document.getElementById('logContent').textContent = originalContent;
            document.getElementById('searchResults').textContent = '';
            document.getElementById('searchInput').value = '';
        }

        function copyToClipboard() {
            const content = document.getElementById('logContent').textContent;
            navigator.clipboard.writeText(content).then(() => {
                alert('Contenido copiado al portapapeles');
            }).catch(err => {
                alert('Error al copiar: ' + err);
            });
        }

        function escapeRegExp(string) {
            return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        }

        // Auto-scroll al final
        window.addEventListener('load', function() {
            const logContent = document.getElementById('logContent');
            if (logContent) {
                logContent.scrollTop = logContent.scrollHeight;
            }
        });
    </script>
</body>
</html>
