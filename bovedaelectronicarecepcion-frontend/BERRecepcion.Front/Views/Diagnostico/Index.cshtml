@{
    ViewData["Title"] = "Diagnóstico del Sistema";
    Layout = null; // Sin layout para evitar dependencias de autenticación
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BER</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        body { padding: 20px; background-color: #f5f5f5; }
        .diagnostic-card { margin-bottom: 20px; }
        .status-ok { color: #28a745; }
        .status-error { color: #dc3545; }
        .status-warning { color: #ffc107; }
        pre { background-color: #1e1e1e; color: #d4d4d4; padding: 15px; border-radius: 5px; max-height: 400px; overflow-y: auto; font-size: 12px; }
        .diagnostic-value { font-family: 'Courier New', monospace; background-color: #e9ecef; padding: 5px 10px; border-radius: 3px; }
        .header-logo { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; padding: 30px; border-radius: 10px; margin-bottom: 30px; }
    </style>
</head>
<body>
    <div class="container">
        <div class="header-logo text-center shadow">
            <h1><i class="fas fa-stethoscope"></i> Diagnóstico del Sistema</h1>
            <p class="mb-0">Boveda Electrónica de Recepción - PEMEX</p>
            <small>Página accesible sin autenticación para diagnóstico</small>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-triangle"></i> <strong>Error:</strong> @ViewBag.Error
            </div>
        }
        else if (ViewBag.Diagnostico != null)
        {
            dynamic diag = ViewBag.Diagnostico;
            
            <!-- Timestamp -->
            <div class="alert alert-info">
                <i class="fas fa-clock"></i> <strong>Timestamp:</strong> @diag.Timestamp
            </div>

            <div class="row">
                <!-- Azure AD Configuration -->
                <div class="col-md-6">
                    <div class="card diagnostic-card shadow">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="fas fa-key"></i> Configuración Azure AD</h5>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm">
                                <tr>
                                    <td><strong>Instance:</strong></td>
                                    <td class="diagnostic-value">@diag.AzureAD.Instance</td>
                                </tr>
                                <tr>
                                    <td><strong>Tenant ID:</strong></td>
                                    <td class="diagnostic-value">@diag.AzureAD.TenantId</td>
                                </tr>
                                <tr>
                                    <td><strong>Client ID:</strong></td>
                                    <td class="diagnostic-value">@diag.AzureAD.ClientId</td>
                                </tr>
                                <tr>
                                    <td><strong>WebApp URI:</strong></td>
                                    <td class="diagnostic-value">@diag.AzureAD.WebAppURI</td>
                                </tr>
                                <tr>
                                    <td><strong>Callback Path:</strong></td>
                                    <td class="diagnostic-value">@diag.AzureAD.CallbackPath</td>
                                </tr>
                                <tr class="table-warning">
                                    <td><strong>Redirect URI Esperado:</strong></td>
                                    <td class="diagnostic-value"><strong>@diag.AzureAD.ExpectedRedirectUri</strong></td>
                                </tr>
                            </table>
                            <div class="alert alert-warning mt-3">
                                <strong>⚠️ VERIFICAR:</strong> Este Redirect URI debe estar registrado en Azure AD Portal
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Data Protection -->
                <div class="col-md-6">
                    <div class="card diagnostic-card shadow">
                        <div class="card-header @(diag.DataProtection.exists ? "bg-success" : "bg-danger") text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-shield-alt"></i> Data Protection Keys
                                @if (diag.DataProtection.exists)
                                {
                                    <span class="badge bg-light text-success float-end">✓ OK</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-danger float-end">✗ ERROR</span>
                                }
                            </h5>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm">
                                <tr>
                                    <td><strong>Estado:</strong></td>
                                    <td>
                                        <span class="@(diag.DataProtection.exists ? "status-ok" : "status-error")">
                                            @diag.DataProtection.status
                                        </span>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Ubicación:</strong></td>
                                    <td class="diagnostic-value">@diag.DataProtection.location</td>
                                </tr>
                                <tr>
                                    <td><strong>Archivos de Claves:</strong></td>
                                    <td><strong>@diag.DataProtection.keysCount</strong></td>
                                </tr>
                            </table>
                            
                            @if (!diag.DataProtection.exists)
                            {
                                <div class="alert alert-danger mt-3">
                                    <strong>🚨 PROBLEMA CRÍTICO:</strong>
                                    <p class="mb-0">@diag.DataProtection.message</p>
                                    <hr/>
                                    <small>
                                        <strong>Causa probable:</strong> Permisos insuficientes para crear carpetas<br/>
                                        <strong>Impacto:</strong> La autenticación fallará constantemente
                                    </small>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-success mt-3">
                                    <strong>✓ Configuración Correcta</strong>
                                    <p class="mb-0">Las claves de encriptación están persistiendo correctamente.</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- Logs -->
                <div class="col-md-6">
                    <div class="card diagnostic-card shadow">
                        <div class="card-header @(diag.Logs.exists ? "bg-info" : "bg-warning") text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-file-alt"></i> Archivos de Log
                                @if (diag.Logs.exists)
                                {
                                    <span class="badge bg-light text-info float-end">✓ Disponibles</span>
                                }
                            </h5>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm">
                                <tr>
                                    <td><strong>Ubicación:</strong></td>
                                    <td class="diagnostic-value">@diag.Logs.path</td>
                                </tr>
                                @if (diag.Logs.exists)
                                {
                                    <tr>
                                        <td><strong>Total de Archivos:</strong></td>
                                        <td><strong>@diag.Logs.filesCount</strong></td>
                                    </tr>
                                    @if (diag.Logs.latestFile != null)
                                    {
                                        <tr>
                                            <td><strong>Último Archivo:</strong></td>
                                            <td class="diagnostic-value">@diag.Logs.latestFile</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Última Modificación:</strong></td>
                                            <td>@diag.Logs.latestModified</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="2">
                                            <div class="alert alert-warning mb-0">
                                                <strong>⚠️ Carpeta de logs no encontrada</strong>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </table>
                            
                            @if (diag.Logs.exists)
                            {
                                <div class="d-grid gap-2">
                                    <a href="@Url.Action("VerLogs", "Diagnostico", new { origen = "frontend", lines = 50 })" class="btn btn-primary">
                                        <i class="fas fa-desktop"></i> Ver Logs Frontend (50 líneas)
                                    </a>
                                    <a href="@Url.Action("VerLogs", "Diagnostico", new { origen = "backend", lines = 50 })" class="btn btn-success">
                                        <i class="fas fa-server"></i> Ver Logs Backend (50 líneas)
                                    </a>
                                    <a href="@Url.Action("VerLogs", "Diagnostico", new { origen = "frontend", lines = 200 })" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-eye"></i> Frontend - 200 líneas
                                    </a>
                                    <a href="@Url.Action("VerLogs", "Diagnostico", new { origen = "backend", lines = 200 })" class="btn btn-outline-success btn-sm">
                                        <i class="fas fa-eye"></i> Backend - 200 líneas
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Ambiente -->
                <div class="col-md-6">
                    <div class="card diagnostic-card shadow">
                        <div class="card-header bg-secondary text-white">
                            <h5 class="mb-0"><i class="fas fa-server"></i> Información del Ambiente</h5>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm">
                                <tr>
                                    <td><strong>Aplicativo:</strong></td>
                                    <td>@diag.Ambiente.Aplicativo</td>
                                </tr>
                                <tr>
                                    <td><strong>Versión:</strong></td>
                                    <td>@diag.Ambiente.Version</td>
                                </tr>
                                <tr>
                                    <td><strong>Ambiente:</strong></td>
                                    <td><span class="badge bg-info">@diag.Ambiente.Ambiente</span></td>
                                </tr>
                                <tr>
                                    <td><strong>API URL:</strong></td>
                                    <td class="diagnostic-value">@diag.Ambiente.ApiUrl</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Acciones Rápidas -->
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="fas fa-tools"></i> Acciones Rápidas</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 mb-2">
                            <a href="@Url.Action("Status", "Diagnostico")" class="btn btn-outline-primary w-100" target="_blank">
                                <i class="fas fa-code"></i> Ver JSON Status
                            </a>
                        </div>
                        <div class="col-md-4 mb-2">
                            <a href="/" class="btn btn-outline-success w-100">
                                <i class="fas fa-home"></i> Ir al Inicio (Login)
                            </a>
                        </div>
                        <div class="col-md-4 mb-2">
                            <button onclick="location.reload()" class="btn btn-outline-secondary w-100">
                                <i class="fas fa-sync-alt"></i> Actualizar Diagnóstico
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Instrucciones -->
            <div class="card shadow mt-3">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="fas fa-lightbulb"></i> ¿Qué hacer con esta información?</h5>
                </div>
                <div class="card-body">
                    <h6><strong>1. Verificar Redirect URI en Azure AD:</strong></h6>
                    <ul>
                        <li>Ir a <a href="https://portal.azure.com" target="_blank">Azure Portal</a></li>
                        <li>Azure Active Directory → App registrations</li>
                        <li>Buscar ClientId: <code>@diag.AzureAD.ClientId</code></li>
                        <li>Authentication → Redirect URIs</li>
                        <li>Debe incluir: <strong><code>@diag.AzureAD.ExpectedRedirectUri</code></strong></li>
                    </ul>

                    <h6><strong>2. Si Data Protection Keys = ERROR:</strong></h6>
                    <ul>
                        <li>Verificar permisos del App Pool en IIS</li>
                        <li>El usuario del App Pool debe tener permisos de escritura en la carpeta de la aplicación</li>
                        <li>Revisar los logs para ver qué ubicaciones se intentaron</li>
                    </ul>

                    <h6><strong>3. Revisar Logs:</strong></h6>
                    <ul>
                        <li>Click en "Ver Últimas Líneas" arriba</li>
                        <li>Buscar mensajes con "Data Protection", "AADSTS", "Error"</li>
                        <li>Los logs mostrarán exactamente qué está fallando</li>
                    </ul>
                </div>
            </div>
        }
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
