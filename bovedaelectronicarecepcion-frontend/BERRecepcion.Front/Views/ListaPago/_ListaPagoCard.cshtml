@using BERRecepcion.Front.Models.Dto
@using Newtonsoft.Json
@model DataResult<IEnumerable<PaymentListDto>>

@{
    bool contieneInfo = Model != null && Model.Data != null && Model.Data.Count() > 0;
}
<div class="card">
    <div class="card-header">
        <div class="row">
            <div class="col-md-8">
                @if (contieneInfo)
                {
                    <h6>Información de la lista de pago</h6>
                    <small>Seleccione el documento a firmar</small>
                }
            </div>
            <div class="col-md-4">
                <form id="lista-pago-form-search">
                    <div class="input-group">
                        <input type="search" class="form-control form-control-sm" autocomplete="off" placeholder="Búsqueda de listas de pago" value="@ViewBag.Search" id="search">
                        <div class="input-group-append">
                            <button type="submit" class="btn btn-sm btn-default">
                                <i class="fa fa-search"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="card-body">
        @if (contieneInfo)
        {
            <table class="table table-hover" id="lista-pago-table" style="font-size:14px;">
                <thead>
                    <tr>
                        <th class="text-center">PDF</th>
                        <th></th>
                        <th>Consolidación ID</th>
                        <th>Fecha pago</th>
                        <th>Organismo</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Data)
                    {
                        <tr>
                            <td scope="row" class="text-center">
                                <i class="fas fa-file-pdf image-pdf pdf-red-color" data-id="@item.PaymentListID" data-lpid="@item.ListaPago_Id"></i>
                            </td>
                            <td scope="row" class="text-center">
                                @{
                                    var _model = new Dictionary<string, object>
                                                                                                                    {
                                            {"ItemID", item.PaymentListID }, //Obligatorio para estandarizar ID's
                                            {"Descripcion", item.ListaPago_Id },
                                            {"PaymentListID", item.PaymentListID },
                                            {"ListaPago_Id", item.ListaPago_Id },
                                            {"OrganismClave", item.OrganismClave },
                                            {"TokenTo", item.TokenTo }
                                        };
                                }
                                <div class="custom-control custom-checkbox">
                                    <input class="custom-control-input custom-control-input-danger custom-control-input-outline" type="checkbox" name="checkPDF" id="@item.PaymentListID" @((ViewBag.PDFCheckDisabled == null || ViewBag.PDFCheckDisabled) ? "disabled" : "") data-model="@JsonConvert.SerializeObject(_model)" />
                                    <label class="custom-control-label" for="@item.PaymentListID"></label>
                                </div>
                            </td>
                            <td scope="row">@item.ListaPago_Id</td>
                            <td scope="row">@item.Date.ToString("dd/MM/yyyy")</td>
                            <td scope="row">@item.OrganismClave</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="row mt-2">
                <div class="col-12 col-sm-3 col-md-2 col-lg-2 col-xl-2 mt-1 mb-2">
                    <button class="btn btn-sm btn-outline-success w-100" onclick="validarInfo(event);" style="width:100px;">
                        Firmar<i class="fas fa-pencil-alt float-right mt-1"></i>
                    </button>
                </div>
                <div class="col-12 col-sm-9 col-md-10 col-lg-10 col-xl-10">
                    <partial name="_Pagination" model="@Model.Pager" />
                </div>
            </div>
            <script>
                $(function () {
                    DataTableInitialize("lista-pago-table");
                });
            </script>
        }
        else
        {
            <div class="callout callout-info">
                <p>No se han encontrado listas de pago.</p>
            </div>
        }
    </div>
    <!-- /.card-body -->
</div>