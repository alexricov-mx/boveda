@model BERRecepcion.Front.Models.Dto.AnaliticoPagoDto
@using Newtonsoft.Json
<div class="row datos-factura">
    <div class="col-12">
        <div class="callout callout-info">
            <div class="form-group row m-0">
                <h3 class="col-xl-4 col-lg-4 col-md-7 col-sm-12 card-title m-auto">
                    <i class="fas fa-file-invoice mr-2"></i>Prefactura
                </h3>
                <div class="col-xl-8 col-lg-8 col-md-5 col-sm-12 m-0">
                    <button class="btn btn-sm btn-outline-info float-right" id="btnDocumentoAnalitico" data-analiticoid="@Model.AnaliticoPagoID">
                        <i class="fas fa-eye mr-1"></i> Ver documento Analitico
                    </button>
                </div>
            </div>
            <hr />
            <dl class="row m-0">
                <dt class="col-sm-3">RFC Emisor:</dt>
                <dd class="col-sm-9">@Model.CreditorRFC</dd>
                <dt class="col-sm-3">Razón Social:</dt>
                <dd class="col-sm-9">@Model.Creditor</dd>
                <dt class="col-sm-3">No. Acreedor:</dt>
                <dd class="col-sm-9">@Model.NumAcreedor</dd>
                <dt class="col-sm-3">No. Analítico:</dt>
                <dd class="col-sm-9">@Model.Analitico</dd>
                <dt class="col-sm-3">Ejercicio:</dt>
                <dd class="col-sm-9">@Model.Ejercicio</dd>
            </dl>
        </div>
    </div>

    <div class="col-md-12">
        <div class="callout callout-info">
            <h5 class="mb-3">
                <i class="fas fa-file-contract mr-2"></i> Conceptos
            </h5>
            <div class="table-responsive">
                <table class="table table-striped table-hover m-0">
                    <thead>
                        <tr>
                            <th>Cantidad</th>
                            <th>Unidad</th>
                            <th>Valor unitario</th>
                            <th>Importe</th>
                            <th>Descripción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.vPreFactura.comprobante.conceptos)
                        {
                            <tr>
                                <td>@item.cantidad</td>
                                <td>@item.unidad</td>
                                <td>$@String.Format("{0:#,##0.#0}", Convert.ToDouble(item.valorUnitario))</td>
                                <td>$@String.Format("{0:#,##0.#0}", Convert.ToDouble(item.importe))</td>
                                <td>@item.descripcion</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
<div class="row datos-factura">
    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12">
        <div class="callout callout-info">
            <h6 class="text-muted m-0 mr-1">
                Subtotal:
                <strong class="ml-1">$@String.Format("{0:#,##0.#0}", Convert.ToDouble(Model.vPreFactura.comprobante.subtotal))</strong>
            </h6>
        </div>
    </div>
    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12">
        <div class="callout callout-info">
            <h6 class="text-muted m-0 mr-1">
                Impuestos trasladados:
                <strong class="ml-1">$@String.Format("{0:#,##0.#0}", Convert.ToDouble(Model.vImpuestos.totalImpuestosTrasladados))</strong>
            </h6>
        </div>
    </div>
    <div class="col-xl-4 col-lg-4 col-md-6 col-sm-12">
        <div class="callout callout-info">
            <h6 class="text-muted m-0 mr-1">
                Impuestos retenidos:
                <strong class="ml-1">$@String.Format("{0:#,##0.#0}", Convert.ToDouble(Model.vImpuestos.totalImpuestosRetenidos))</strong>
            </h6>
        </div>
    </div>
    <div class="col-xl-3 col-lg-3 col-md-6 col-sm-12">
        <div class="callout callout-info">
            <h6 class="text-muted m-0 mr-1">
                Total:
                <strong class="ml-1">$@String.Format("{0:#,##0.#0}", Convert.ToDouble(Model.vPreFactura.comprobante.total))</strong>
            </h6>
        </div>
    </div>
    <div class="col-xl-2 col-lg-2 col-md-6 col-sm-12">
        <div class="callout callout-info">
            <h6 class="text-muted m-0 mr-1">
                Moneda: <strong class="ml-1">@Model.vPreFactura.comprobante.moneda</strong>
            </h6>
        </div>
    </div>
</div>
<div class="row datos-factura">
    <div class="col-md-12">
        <div class="callout callout-info">
            <h5>
                <i class="fas fa-file-invoice mr-2"></i>
                Factura
            </h5>
            <hr />
            <dl class="row m-0">
                <dt class="col-sm-3">Versión CFDI</dt>
                <dd class="col-sm-9">@Model.Comprobante.Version</dd>
                <dt class="col-sm-3">Serie</dt>
                <dd class="col-sm-9">@Model.Comprobante.Serie</dd>
                <dt class="col-sm-3">Folio:</dt>
                <dd class="col-sm-9">@Model.Comprobante.Folio</dd>
                <dt class="col-sm-3">Fecha factura:</dt>
                <dd class="col-sm-9">@(Convert.ToDateTime(Model.Comprobante.Fecha).ToString("dd/MM/yyyy"))</dd>
                <dt class="col-sm-3">UUID:</dt>
                <dd class="col-sm-9">@Model.Comprobante.Complemento.TimbreFiscalDigital.UUID.ToString().ToUpper()</dd>
                <dt class="col-sm-3">VU / Asignación:</dt>
                <dd class="col-sm-9"><input type="text" class="form-control form-control-sm col-sm-4" id="factura-Region" /></dd>
            </dl>
        </div>
    </div>
</div>
@if (@Model.Comprobante.Complemento.CartaPorte != null)
{
    <div class="row datos-factura">
        <div class="col-12">
            <partial name="_CartaPorte" model="@Model.Comprobante.Complemento.CartaPorte" />
        </div>
    </div>
}
<div class="row datos-factura">
    <partial name="_InfoAddenda" model="@Model.Comprobante.Addenda.Addenda_Pemex" />
</div>
<div class="row">
    <div class="col-12" id="validationErrorsFactura"></div>
</div>
<div class="row datos-factura">
    <div class="col-12">
        <button class="btn btn-sm btn-outline-success float-right" id="btnEnviarFactura" style="width:100px;">
            Enviar <i class="fas fa-chevron-right float-right mt-1"></i>
        </button>
        <button class="btn btn-sm btn-outline-info float-right mr-2" id="btnLimpiar" style="width:100px;">
            Limpiar <i class="fas fa-stamp float-right mt-1"></i>
        </button>
    </div>
</div>

