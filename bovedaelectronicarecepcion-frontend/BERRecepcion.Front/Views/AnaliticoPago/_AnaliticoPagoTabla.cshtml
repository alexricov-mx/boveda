@using BERRecepcion.Front.Models.Dto
@using Newtonsoft.Json
@model DataResult<IEnumerable<AnaliticoPagoDto>>
@{
    bool contieneAnaliticos = Model != null && Model.Data != null && Model.Data.Count() > 0;
}
<div class="card">
    <div class="card-header">
        <div class="row">
            <div class="col-md-8">
                @if (contieneAnaliticos)
                {
                    <h6>Información del analítico de pago</h6>
                    <small>Seleccione el documento a firmar</small>
                }
            </div>
            <div class="col-md-4">
                <form id="ap-form-search">
                    <div class="input-group mb-3">
                        <input type="search" class="form-control form-control-sm" value="@ViewBag.Search" id="search" autocomplete="off" placeholder="Buscar Analítico de Pago">
                        <div class="input-group-append">
                            <button type="submit" class="btn btn-sm btn-default">
                                <i class="fa fa-search"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (contieneAnaliticos)
    {
        <div class="card-body">
            <table class="table table-hover" id="analiticopago-table" style="font-size:14px;">
                <thead>
                    <tr>
                        <th class="text-center">PDF</th>
                        <th></th>
                        <th>Analitico</th>
                        <th>Ejercicio</th>
                        <th>Trasportista</th>
                        <th>Cliente</th>
                        <th>Cédula</th>
                        <th>Organismo</th>
                        <th>Fecha</th>
                        <th class="text-right">Total</th>
                        <th>Contrato</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Data)
                    {
                        <tr>
                            <td scope="row" class="text-center">
                                <i class="fas fa-file-pdf image-pdf pdf-red-color" data-id="@item.AnaliticoPagoID" data-cvetransportista="@item.CveTransportista" data-numcliente="@item.NumCliente" data-exercise="@item.Ejercicio" data-analitico="@item.Analitico"></i>
                            </td>
                            <td scope="row" class="text-center">
                                @{
                                    var _model = new Dictionary<string, object>
                                                            {
                                        {"ItemID", item.AnaliticoPagoID }, //Obligatorio para estandarizar ID's
                                        {"Descripcion", string.Concat(item.IdAnalitico, " - ", item.NumCliente) },
                                        {"AnaliticoPagoID", item.AnaliticoPagoID },
                                        {"CveTransportista", item.CveTransportista },
                                        {"NumCliente", item.NumCliente },
                                        {"Ejercicio", item.Ejercicio },
                                        {"Analitico", item.Analitico },
                                        { "NumAcreedor", item.NumAcreedor},
                                        { "FunctionarySignDate", item.FunctionarySignDate}
                                    };
                                }
                                <div class="custom-control custom-checkbox">
                                    <input class="custom-control-input custom-control-input-danger custom-control-input-outline" type="checkbox" name="checkPDF" id="@item.Analitico" data-model="@JsonConvert.SerializeObject(_model)" />
                                    <label class="custom-control-label" for="@item.Analitico"></label>
                                </div>
                            </td>
                            <td>@item.Analitico</td>
                            <td>@item.Ejercicio</td>
                            <td>@item.CveTransportista</td>
                            <td>@item.NumCliente</td>
                            <td>@item.Cedula</td>
                            <td>@item.clave</td>
                            <td>@item.FechaEmision</td>
                            <td scope="row" class="text-right">$@String.Format("{0:#,##0.#0}", Convert.ToDouble(item.Total))</td>
                            <td> @item.Contrato</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="row mt-2">
                <div class="col-12 col-sm-3 col-md-2 col-lg-2 col-xl-2 mt-1 mb-2">
                    <button class="btn btn-sm btn-outline-success w-100" onclick="validarInfo(event);" style="width:100px;">
                        Firmar<i class="fas fa-pencil-alt float-right mt-1"></i>
                    </button>
                </div>
                <div class="col-12 col-sm-9 col-md-10 col-lg-10 col-xl-10">
                    <partial name="_Pagination" model="@Model.Pager" />
                </div>
            </div>

        </div>

        <script>
            $(function () {
                DataTableInitialize("analiticopago-table");
            });
        </script>
    }
    else
    {
        <div class="callout callout-info">
            <p>No se encontraron Analíticos de Pago.</p>
        </div>
    }


</div>