<style>
    input.small-custom, select.small-custom,
    select.small-custom, input.small-custom::placeholder {
        font: 14px/3 sans-serif;
    }
</style>

<div class="row">
    <div class="col-12">
        <hr class="bg-light-pink" />
        <h4 class="text-dark">Agregar usuario</h4>
    </div>
</div>
<div class="row mt-3">
    <div class="col-12 col-md-6">
        <div class="form-group">
            <label for="TipoUsuario" class="col-form-label text-sm text-secondary">Tipo de Usuario</label>
            <select class="form-control form-control-lg bg-light-pink rounded border-0 small-custom" type="text" id="TipoUsuario" autocomplete="off">
                <option id="1">Funcionario</option>
            </select>
        </div>
    </div>
    <div class="col-12 col-md-6">
        <div class="form-group ">
            <label class="col-form-label text-sm text-secondary" for="Token">Ficha</label>
