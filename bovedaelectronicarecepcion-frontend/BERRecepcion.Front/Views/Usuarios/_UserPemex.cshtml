        </div>
    </div>
    <div class="col-12 col-md-2">
        <div class="form-group ">
            <label class="col-form-label text-sm text-secondary" for="Nombre">Vigencia fin</label>
            <input type="date" class="form-control form-control-lg bg-light-pink rounded border-0 small-custom" id="VigenciaFin">
        </div>
    </div>


    <div class="col-12 col-md-4">
        <div class="form-group ">
            <label class="col-form-label text-sm text-secondary" for="Nombre">RFC</label>
            <input type="text" class="form-control form-control-lg bg-light-pink rounded border-0 small-custom" id="Nombre" placeholder="RFC">
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="form-group ">
            <label class="col-form-label text-sm text-secondary" for="Nombre">Centro</label>
            <input type="text" class="form-control form-control-lg bg-light-pink rounded border-0 small-custom" id="VigenciaInicio" placeholder="Centro">
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="form-group ">
            <label class="col-form-label text-sm text-secondary" for="Nombre">Perfil</label>
            <input type="text" class="form-control form-control-lg bg-light-pink rounded border-0 small-custom" id="VigenciaFin" placeholder="Perfil">
        </div>
    </div>
    <div class="col-12">
        <div class="alert alert-default-secondary border-0 elevation-1">
            <label class="h6 mr-3">Indica los organismos en los cuales tendrá actividad</label>
            <button class="btn btn-success border-0 rounded-pill mr-2 text-sm pl-3 pr-3 bg-pantone7421" data-toggle="modal" data-target="#modal-pemex">
                Organismos
            </button>
            <hr />
            <label class="h6">Organismos asignados</label>
            <p class="mr-3 text-sm">PEP</p>
            <p class="mr-3 text-sm">PTRI</p>
            <p class="mr-3 text-sm">PCORP</p>
        </div>

       
    </div>
</div>
<div class="row">
    <div class="col-12 col-sm-6 col-md-12 d-flex justify-content-end">
        <button class="btn btn-success border-0 text-sm pl-4 pr-4 pt-2 pb-2 bg-pantone7421 mr-3" id="cancel-user">
            Cancelar
        </button>
        <button class="btn btn-success border-0 text-sm pl-4 pr-4 pt-2 pb-2 bg-pantone7421" id="save-user">
            Guardar
        </button>
    </div>
</div>

