            <input type="text" class="form-control form-control-lg bg-light-pink rounded border-0 small-custom" id="Nombre" placeholder="Nombre">
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="form-group ">
            <label class="col-form-label text-sm text-secondary" for="Nombre">Correo electrónico</label>
