@{
    ViewData["Title"] = "Administración de usuarios";
}
<style>
    input.small-custom, select.small-custom,
    select.small-custom, input.small-custom::placeholder {
        font: 14px/3 sans-serif;
    }
</style>

<!-- header -->
<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-12 col-md-6">
                <h1 class="m-0">Administración de usuarios</h1>
            </div>
            <div class="col-12 col-md-6">
                <ol class="breadcrumb float-sm-right bordered">
                    <li class="breadcrumb-item mr-4 mt-1">Nuevo usuario: </li>
                    <li>
                        <button class="btn btn-success border-0 rounded-pill mr-2 text-sm pl-4 pr-4 pt-2 pb-2 bg-pantone7421" id="user-pemex">
                            <i class="fas fa-plus mr-1"></i> Pemex
                        </button>
                    </li>
                    <li>
                        <button class="btn btn-success border-0 rounded-pill text-sm pl-4 pr-4 pt-2 pb-2 bg-pantone7421" id="user-external">
                            <i class="fas fa-plus mr-1"></i> Externo
                        </button>
                    </li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- content -->
<section class="content ml-3 mr-3 mt-0"> 
    <div class="container-fluid">
        <div class="row">
            <div class="col-12 col-md-5">
                <form id="user-form-search">
                    <div class="input-group">
                        <input type="search" class="form-control border-0" autocomplete="off" placeholder="Buscar" id="search" autofocus>
                        <div class="input-group-append">
                            <button type="submit" class="btn btn-sm btn-default border-0 bg-white pl-3 pr-3">
                                <i class="fa fa-search"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        <div id="div-user-table" class="mt-3 pl-0">
        </div>
    </div>
    @await Html.PartialAsync("Pemex/_ModalAddPemex")
    @await Html.PartialAsync("External/_ModalAddExternal")
    @await Html.PartialAsync("External/_ModalExternalOrganism")
</section>

<!-- js -->
@section scripts{
    <script type="text/javascript" src="@Url.Content("~/js/Usuarios/index.js")"></script>
}

