@using BERRecepcion.Front.Models.Dto
@using Newtonsoft.Json
@model DataResult<IEnumerable<CopadeDto>>

@{
    bool contieneCopades = Model != null && Model.Data != null && Model.Data.Count() > 0;
}

<div class="card">
    <div class="card-header">
        <div class="row">
            <div class="col-md-8">
                @if (contieneCopades)
                {
                    <h6>Información de Copades</h6>
                    <small>Seleccione el documento a firmar</small>
                }
            </div>
            <div class="col-md-4">
                <form id="copade-form-search">
                    <div class="input-group">
                        <input type="search" class="form-control form-control-sm" value="@ViewBag.Search" id="search" autocomplete="off" placeholder="Buscar Copade">
                        <div class="input-group-append">
                            <button type="submit" class="btn btn-sm btn-default">
                                <i class="fa fa-search"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="card-body">
        @if (contieneCopades)
        {
            <table class="table table-hover" id="copade-table" style="font-size:14px;">
                <thead>
                    <tr>
                        <th class="text-center">PDF</th>
                        <th></th>
                        <th>COPADE</th>
                        <th>No. OS</th>
                        <th>No. Contrato</th>
                        <th>Organismo</th>
                        <th>Tipo</th>
                        <th>Centro</th>
                        <th>Ejercicio</th>
                        <th>Total</th>
                        <th>Firmante1</th>
                        <th>Firmante2</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Data)
                    {
                        <tr>
                            <td scope="row" class="text-center">
                                <i class="fas fa-file-pdf image-pdf pdf-red-color" data-id="@item.CopadeID" onclick="pdfPreview('@item.clave', '@item.SapOrder', '@item.Reception', '@item.Exercise', '@item.Functionary1SignDate', '@item.CopadeID')"></i>
                            </td>
                            <td scope="row" class="text-center">
                                @{ 
                                    var _model = new Dictionary<string, object>
                                                    {
                                    {"ItemID", item.CopadeID }, //Obligatorio para estandarizar ID's
                                    {"Descripcion", string.Concat(item.Reception, " - ", item.SapOrder) },
                                    {"CopadeID", item.CopadeID },
                                    {"SAPOrder", item.SapOrder },
                                    {"Contract", item.Contract },
                                    {"Reception", item.Reception },
                                    {"Exercise", item.Exercise },
                                    {"Clave", item.clave },
                                    {"Functionary1SignDate", item.Functionary1SignDate },
                                    {"CreditorNumber", item.CreditorNumber }
                                };
                                }
                                <div class="custom-control custom-checkbox">
                                    <input class="custom-control-input custom-control-input-danger custom-control-input-outline" type="checkbox" name="checkPDF" id="@item.Reception" data-model="@JsonConvert.SerializeObject(_model)" />
                                    <label class="custom-control-label" for="@item.Reception"></label>
                                </div>
                            </td>
                            <td scope="row">@item.Reception</td>
                            <td scope="row">@item.SapOrder</td>
                            <td scope="row">@item.Contract</td>
                            <td scope="row">@item.clave</td>
                            <td scope="row">@item.DocumentType</td>
                            <td scope="row">@item.Center</td>
                            <td scope="row">@item.Exercise</td>
                            <td scope="row">$@item.Total</td>

                            <td scope="row" class="text-center"><span class="@(string.IsNullOrWhiteSpace(item.Functionary1SignDate.ToString()) ? "dot" : "dot-active")"></span></td>
                            <td scope="row" class="text-center"><span class="@(string.IsNullOrWhiteSpace(item.Functionary2SignDate.ToString()) ? "dot" : "dot-active")"></span></td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="row mt-2">
                <div class="col-12 col-sm-3 col-md-2 col-lg-2 col-xl-2 mt-1 mb-2">
                    <button class="btn btn-sm btn-outline-success w-100" onclick="validarInfo(event);" style="width:100px;">
                        Firmar<i class="fas fa-pencil-alt float-right mt-1"></i>
                    </button>
                </div>
                <div class="col-12 col-sm-9 col-md-10 col-lg-10 col-xl-10">
                    <partial name="_Pagination" model="@Model.Pager" />
                </div>
            </div>
            <script>
                $(function () {
                    DataTableInitialize("copade-table");
                });
            </script>
        }
        else
        {
            <div class="callout callout-info">
                <p>No tiene Copades pendientes.</p>
            </div>
        }
    </div>
    <!-- /.card-body -->
</div>
<!-- /.card -->