@using BERRecepcion.Front.Models.Dto
@model DataResult<IEnumerable<ProfilesDto>>
@{
    bool contienePerfiles = Model != null && Model.Data != null && Model.Data.Count() > 0;
}
<div class="card">
    <div class="card-header">
        <div class="row">
            <div class="col-lg-12 col-md-12 col-sm-12 text-left">
                <div class="row">
                    <div class="col-12 col-sm-12 col-md-6 col-lg-8 col-xl-8">
                        <h5 class="mb-0 text-olive">
                            <i class="fa fa-filter"></i> Filtro
                        </h5>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3 col-lg-2 col-xl-2">
                        <button class="btn btn-sm btn-outline-info float-right w-100 mt-2 mt-sm-1 mt-md-0 mt-lg-o mt-xl-0" id="profile-new" style="width:135px;"><i class="fas fa-plus mr-1"></i> Nuevo</button>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3 col-lg-2 col-xl-2">
                        <button class="btn btn-sm btn-outline-success float-right w-100 mt-2 mt-sm-1 mt-md-0 mt-lg-o mt-xl-0" style="width:135px;" id="Excel"><span class="fas fa-download"></span> Excel</button>
                    </div>
                </div>
                @*<a class="btn btn-sm btn-outline-info" id="profile-new" style="width:135px;"><i class="fas fa-plus mr-1"></i> Nuevo</a>

                <a class="btn btn-sm btn-outline-success float-right" style="width:135px;" href="@Url.Action("DownloadExcel", "Perfiles")"><i class="fas fa-download mr-1"></i> Excel</a>*@
            </div>
        </div>
    </div>
    <!-- /.card-header -->
    <div class="card-body" id="profiles-table">
        <div class="row">
            <div class="col-md-4 offset-md-8">
                <form id="profiles-form-search">
                    <div class="input-group mb-3">
                        <input type="search" class="form-control form-control-sm" value="@ViewBag.Search" id="search" autocomplete="off" placeholder="Buscar perfil">
                        <div class="input-group-append">
                            <button type="submit" class="btn btn-sm btn-default">
                                <i class="fa fa-search"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
        @if (contienePerfiles)
        {
            <div class="row">
                @foreach (var item in Model.Data)
                {
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="info-box">
                            <span class="info-box-icon elevation-1"><i class="fas fa-users-cog"></i></span>

                            <div class="info-box-content">
                                <span class="info-box-text text-wrap">
                                    <small>
                                        <label class="text-muted" data-toggle="tooltip" data-placement="top" title="@item.Name">
                                            @(item.Name.Length > 18 ? item.Name.Substring(0, 18) + "..." : item.Name)
                                        </label>
                                    </small>
                                </span>
                                <span class="info-box-text text-wrap">
                                    <small>
                                        <i class="fas fa-ellipsis-v pr-2 pl-2 float-right" style="font-size:17px; cursor:pointer;" data-toggle="dropdown"></i>
                                        <ul class="dropdown-menu">
                                            <li><a class="dropdown-item text-muted text-info w-100" name="profile-edit" style="cursor:pointer;" data-profile="@item.ProfileID">Editar</a></li>
                                            <li><a class="dropdown-item text-muted text-danger w-100" name="profile-delete" style="cursor:pointer;" data-profile="@item.ProfileID">Eliminar</a></li>
                                        </ul>
                                    </small>
                                </span>
                            </div>
                            <!-- /.info-box-content -->
                        </div>
                        <!-- /.info-box -->
                    </div>
                }
            </div>

            <script>
                $(function () {
                    $('[data-toggle="tooltip"]').tooltip();

                    $.each($(".info-box-icon"), function (index, item) {
                        $(this).addClass("bg-" + colors[random(1, 10)]);
                    });
                });
            </script>

        }
        else
        {
            <div class="callout callout-info">
                <p>No se han encontrado perfiles.</p>
            </div>
        }
    </div>
    <!-- /.card-body -->
</div>
<!-- /.card -->
