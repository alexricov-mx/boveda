@using BERRecepcion.Front.Models.Dto
@model DataResult<IEnumerable<AltaContratosDto>>
@if (Model != null && Model.Data != null && Model.Data.Count() > 0)
{
    <table class="table table-hover" id="ac-table" style="font-size:14px;">
        <thead>
            <tr>
                <th></th>
                <th>Contrato</th>
                <th>Firmante 1</th>
                <th>Suplente 1</th>
                <th>Firmante 2</th>
                <th>Suplente 2</th>
                <th>Fecha de Alta</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Data)
            {
                <tr>
                    <td>
                        <span class="info-box-text text-wrap">
                            <small>
                                <button type="button" class="btn btn-sm btn-outline-secondary float-right" data-toggle="dropdown">
                                    <span class="fas fa-cog">
                                    </span>
                                </button>
                                <ul class="dropdown-menu">
                                    <li><button class="dropdown-item text-muted text-info w-100" name="edit" style="cursor:pointer;" data-altacontratoid="@item.AltaContratoID">Editar</button></li>
                                    <li><button class="dropdown-item text-muted text-danger w-100" name="delete" style="cursor:pointer;" data-altacontratoid="@item.AltaContratoID">Eliminar</button></li>
                                </ul>
                            </small>
                        </span>
                    </td>
                    <td>@Html.DisplayFor(modelItem => item.Contract)</td>
                    <td>@Html.DisplayFor(modelItem => item.Firma1)</td>
                    <td>@Html.DisplayFor(modelItem => item.Suplente1)</td>
                    <td>@Html.DisplayFor(modelItem => item.Firma2)</td>
                    <td>@Html.DisplayFor(modelItem => item.Suplente2)</td>
                    <td>@Html.DisplayFor(modelItem => item.Fecha_Alta)</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="row mt-2">
        <div class="col-12">
            <partial name="_Pagination" model="@Model.Pager" />
        </div>
    </div>
    <script>
        $(function () {
            DataTableInitialize("ac-table");
        });
    </script>
}
else
{
    <div class="callout callout-info">
        <p>No se encontraron resultados.</p>
    </div>
}