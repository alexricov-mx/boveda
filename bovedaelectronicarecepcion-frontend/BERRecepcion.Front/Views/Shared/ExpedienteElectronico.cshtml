@model BERRecepcion.Front.Models.ExpedienteEViewModel
@{
    ViewData["Title"] = "Expediente electrónico";
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-12">
                <h3>
                    Expediente electrónico
                    <button class="btn btn-sm btn-secondary float-right" data-redirect="@Model.RedirectAction" style="width:135px;" id="btnRegresar">
                        <i class="fas fa-arrow-left mr-1"></i> Regresar
                    </button>
                </h3>
            </div><!-- /.col -->
        </div><!-- /.row -->
    </div><!-- /.container-fluid -->
</div>
<!-- /.content-header -->
<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                @if (Model.SupplyOrder != null)
                {
                    <div class="callout callout-info">
                        <div class="form-group row">
                            <h3 class="card-title">
                                <i class="fas fa-file-invoice mr-2"></i>Órden de surtimiento
                            </h3>
                        </div>
                        <table class="table table-hover" id="supply-order-table" style="font-size:14px;">
                            <thead>
                                <tr>
                                    <th>No. Contrato</th>
                                    <th>No. OS</th>
                                    <th>Tipo Doc.</th>
                                    <th>Tipo</th>
                                    <th>Ficha Firmante</th>
                                    <th>Nombre Firmante</th>
                                    <th>Proveedor</th>
                                    <th>No. Acreedor</th>
                                    <th>Total</th>
                                    <th>Moneda</th>
                                    <th>Funcionario</th>
                                    <th>Proveedor</th>
                                    <th>Administrador</th>
                                    <th>Estatus ERP</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>@Model.SupplyOrder.Contract</td>
                                    <td>@Model.SupplyOrder.SAPOrder</td>
                                    <td>Estimaciones</td>
                                    @switch (@Model.SupplyOrder.DocumentType)
                                    {
                                        case "B":
                                            <td>Bienes</td>
                                            break;
                                        case "O":
                                            <td>Obras</td>
                                            break;
                                        case "S":
                                            <td>Servicios</td>
                                            break;
                                        case "M":
                                            <td>Medicamentos</td>
                                            break;
                                        default:
                                            <td>@Model.SupplyOrder.DocumentType</td>
                                            break;
                                    }
                                    <td>@Model.SupplyOrder.FunctionaryFicha</td>
                                    <td>@Model.SupplyOrder.FunctionarySignerName</td>
                                    <td>@Model.SupplyOrder.ProviderSignerName</td>
                                    <td>@Model.SupplyOrder.CreditorNumber</td>
                                    <td class="text-right">@Convert.ToDouble(@Model.SupplyOrder.Total).ToString("c")</td>
                                    <td>@Model.SupplyOrder.Currency</td>
                                    <td class="text-center">A<span class="@(@Model.SupplyOrder.FunctionarySignDate.HasValue ? "dot-active" : "dot")"></span></td>
                                    <td class="text-center"><span class="@(@Model.SupplyOrder.ProviderSignDate.HasValue ? "dot-active" : "dot")"></span></td>
                                    <td class="text-center"><span class="@(@Model.SupplyOrder.AdministratorSignDate.HasValue ? "dot-active" : "dot")"></span></td>
                                    <td>@(@Model.SupplyOrder.FunctionarySignDate.HasValue && @Model.SupplyOrder.ProviderSignDate.HasValue ? "Firmado" : (!@Model.SupplyOrder.FunctionarySignDate.HasValue ? "Funcionario" : "Proveedor"))</td>
                                </tr>
                                @*<tr>
                            <td class="text-center">
                            <i class="fas fa-file-pdf image-pdf pdf-red-color" data-id="@Model.SupplyOrder.SupplyOrderID" data-documentobeid="@(!string.IsNullOrWhiteSpace(Model.SupplyOrder.FunctionarySignDate.ToString()) ? Model.SupplyOrder.SupplyOrderID.ToString() : null)" data-sapOrder="@Model.SupplyOrder.SAPOrder" data-organismClave="@Model.SupplyOrder.OrganismClave" data-functionarysigndate="@Model.SupplyOrder.FunctionarySignDate"></i>
                            </td>
                            <td>
                            @Model.SupplyOrder.SAPOrder
                            </td>
                            <td>
                            @Model.SupplyOrder.FunctionarySignerName
                            </td>
                            <td scope="row" class="text-center">
