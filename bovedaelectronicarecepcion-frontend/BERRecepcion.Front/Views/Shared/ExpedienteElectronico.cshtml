                            <i class="fas fa-file-signature" name="detalleFirma" data-documentobeid="@Model.SupplyOrder.SupplyOrderID" data-orden="1" style="font-size:1.5em; cursor:pointer;"></i>
                            }
                            else
                            {
                            <span class="dot"></span>
                            }
                            </td>
                            <td>
                            @(Model.SupplyOrder.FunctionarySignDate != null ? Model.SupplyOrder.FunctionarySignDate.Value.ToString("dd/MM/yyyy HH:mm:ss") : "../../....")
                            </td>
                            <td>@Model.SupplyOrder.ProviderSignerName</td>
                            <td scope="row" class="text-center">
                            @if (!string.IsNullOrWhiteSpace(Model.SupplyOrder.ProviderSignDate.ToString()))
                            {
                            <i class="fas fa-file-signature" name="detalleFirma" data-documentobeid="@Model.SupplyOrder.SupplyOrderID" data-orden="1" style="font-size:1.5em; cursor:pointer;"></i>
                            }
                            else
