@using Newtonsoft.Json
@using BERRecepcion.Front.Models.Dto
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor httpContextAccessor
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    var userMenu = JsonConvert.DeserializeObject<IEnumerable<RolesCatalogoDto>>(httpContextAccessor.HttpContext.Session.GetString("UserMenu")).ToList();
    var user = JsonConvert.DeserializeObject<UsersDto>(User.FindFirst("User").Value);
    var organismItems = string.Join("\n\r", user.Organisms.Select(x => x.Name).Distinct());
    var infoApp = JsonConvert.DeserializeObject<InfoAplicativoModel>(httpContextAccessor.HttpContext.Session.GetString("InfoAplicativo"));
}

@if (userMenu != null && userMenu.Count() > 0)
{
    <aside class="control-sidebar control-sidebar-dark">
        <div class="card card-widget widget-user" style="margin-top: -1px;">
            <div class="widget-user-header bg-secondary rounded-0">
            </div>
            <div class="widget-user-image">
                <img class="img-circle elevation-2" src="~/images/user-image3.jpg" alt="User image">
            </div>
            <div class="card-footer">
                <div class="row mb-3">
                    <div class="col-12 text-center">
                        <h5 class="description-header">@user.Name</h5>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 text-left">
                        <label class="text-muted ml-3"> @user.Token</label>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 text-left">
                        <label class="text-muted ml-3 pointer" data-toggle="tooltip" data-placement="top" title="@organismItems">Organismos</label>
                    </div>
                </div>
                <hr style="border: 2px solid #ccc;" class="pl-0 ml-0">
                <div class="row">
                    <div class="col-12 text-left">
                        <label class="text-muted ml-3"> @infoApp.Aplicativo</label>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 text-left">
                        <label class="text-muted ml-3">BuildId: @infoApp.BuildId</label>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 text-left">
                        <label class="text-muted ml-3">Ambiente: @infoApp.Ambiente</label>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 text-left">
                        <label class="text-muted ml-3"> @infoApp.Mensaje</label>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-12 text-center">
                        <a class="btn btn-sm w-100 mb-0 bg-pantone7420 text-white mt-2" asp-controller="Home" asp-action="Logout">
                            <i class="fas fa-power-off"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </aside>
    @*<aside class="control-sidebar control-sidebar-dark bg-pantone7421">
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title">@user.Name</h3>
            </div>
            <!-- /.card-header -->
            <div class="card-body">
                <label class=" m-0"><i class="fas fa-receipt mr-1"></i> @user.Token</label>
                <hr />
                <label data-toggle="tooltip" data-placement="top" title="@organismItems"><i class="fas fa-building mr-1"></i> Organismos</label>
                <hr class="m-1"/>
                <div class="custom-control custom-checkbox">
                    <input class="custom-control-input custom-control-input-danger custom-control-input-outline" type="checkbox" id="dark-mode-check" style="cursor:pointer;" />
                    <label class="custom-control-label" for="dark-mode-check" style="cursor:pointer;">Tema Oscuro</label>
                </div>
                <hr class="m-1" />
                <label class="mb-1"><i class="fas fa-tag mr-1"></i><b>Aplicativo:</b> @infoApp.Aplicativo</label>
                <hr class="m-1" />
                <label class="mb-1"><i class="fas fa-layer-group mr-1"></i><b>BuildId:</b> @infoApp.BuildId</label>
                <hr class="m-1" />
                <label class="mb-1"><i class="fas fa-globe mr-1"></i><b>Ambiente:</b> @infoApp.Ambiente</label>
                <hr class="m-1" />
                <label class="mb-1"><i class="fas fa-info-circle mr-1"></i> @infoApp.Mensaje</label>
                <hr class="m-1" />
                <a class="btn btn-sm btn-danger w-100 mb-0" asp-controller="Home" asp-action="Logout">
                    Cerrar sesión <i class="fas fa-sign-in-alt"></i>
                </a>
            </div>
        </div>
    </aside>*@

    <aside class="main-sidebar sidebar-light-primary elevation-1">
        <partial name="_Logo" />
        <!-- Sidebar -->
        <div class="sidebar">
            <div class="user-panel mt-4 mb-4 d-flex justify-content-center">
                @*<a class="info m-2" asp-controller="Home">
                    <i class="fas fa-home" style="font-size:25px;"></i>
                </a>*@
                <!--<div class="info">
                    <i class="fas fa-home" style="font-size:30px;"></i>-->
                @*<h4 class="text-muted">Menú</h4>*@
                <!--</div>-->
            </div>
            <!-- Sidebar Menu -->
            <nav class="mt-1">
                <ul class="nav nav-pills nav-sidebar flex-column nav-flat" data-widget="treeview" role="menu" data-accordion="false">
                    @foreach (var menu in userMenu)
                    {
                        <li class="nav-item" id="menu_@menu.Categoria.Replace(" ","").Replace("/","")">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas @menu.Icono"></i>
                                <p>
                                    @menu.Categoria
                                    <i class="fas fa-angle-right right"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                @foreach (var subMenu in menu.SubMenu)
                                {
                                    <li class="nav-item">
                                        <a asp-controller="@subMenu.Controller" id="@subMenu.Rol" asp-action="@subMenu.Action" class="nav-link text-md">
                                            <i class="fas fa-circle nav-icon ml-3 text-dark text-xs"></i>
                                            <p>@subMenu.Descripcion</p>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }

                    @{
                        var vueBase = Configuration["VueApp:BasePath"];
                    }
                    @if (!string.IsNullOrEmpty(vueBase))
                    {
                        <li class="nav-item" id="menu_NuevaVersion">
                            <a href="#" class="nav-link">
                                <i class="nav-icon fas fa-rocket" style="color:#28a745;"></i>
                                <p>
                                    Nueva Versión
                                    <i class="fas fa-angle-right right"></i>
                                    <span class="badge badge-success right">Vue</span>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href="@vueBase/orden-surtimiento" class="nav-link text-md">
                                        <i class="fas fa-circle nav-icon ml-3 text-xs" style="color:#28a745;"></i>
                                        <p>
                                            Órdenes de Surtimiento
                                            <span class="badge badge-success ml-1" style="font-size:9px;">Nuevo</span>
                                        </p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@vueBase/orden-surtimiento/recepcion-almacen" class="nav-link text-md">
                                        <i class="fas fa-circle nav-icon ml-3 text-xs" style="color:#28a745;"></i>
                                        <p>
                                            Recepción de Almacén
                                            <span class="badge badge-success ml-1" style="font-size:9px;">Nuevo</span>
                                        </p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="@vueBase/orden-surtimiento/estimacion-obra" class="nav-link text-md">
                                        <i class="fas fa-circle nav-icon ml-3 text-xs" style="color:#28a745;"></i>
                                        <p>
                                            Estimación de Obra
                                            <span class="badge badge-success ml-1" style="font-size:9px;">Nuevo</span>
                                        </p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }

                </ul>
            </nav>
            <!-- /.sidebar-menu -->
        </div>
        <!-- /.sidebar -->
    </aside>
}
<div id="info-rfc">
    <script>
        sessionStorage.setItem('userRFC', '@user.RFC');
    </script>
</div>
