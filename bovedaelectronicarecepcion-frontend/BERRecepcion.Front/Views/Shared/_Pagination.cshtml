@model BERRecepcion.Front.Models.Pager
<style>
    .page-link {
        padding: 0.38rem 0.59rem;
    }
</style>
<nav aria-label="Page navigation">
    <ul class="pagination d-flex flex-wrap justify-content-center justify-content-md-end mt-2 mt-lg-0 mt-md-0">
        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")" style="cursor:pointer;">
            <a class="page-link" href="#" tabindex="-1" data-page_num="1">
                <i class="fas fa-angle-double-left"></i>
            </a>
        </li>
        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")" style="cursor:pointer;">
            <a class="page-link" href="#" tabindex="-1" data-page_num="@(Model.CurrentPage - 1)">
                <i class="fas fa-angle-left"></i>
            </a>
        </li>
        @{ int startPage = Model.StartPage;}
        @for (var p = Model.StartPage; p <= Model.EndPage; p++)
        {
            if ((Model.CurrentPage >= 5 && Model.StartPage == startPage && Model.TotalPages > 5) || (Model.CurrentPage % 5 == 0 && Model.StartPage == startPage && Model.TotalPages > 5))
            {
                startPage = Model.CurrentPage != Model.EndPage ? Model.CurrentPage - 3 : Model.CurrentPage - 4;
                p = Model.CurrentPage != Model.EndPage ? Model.CurrentPage - 3 : Model.CurrentPage - 4;
            }
            if (p < startPage + 5)
            {
                <li class="page-item @(p == Model.CurrentPage ? "active" : "")" style="cursor:pointer;">
                    <a class="page-link" data-page_num="@p">@p</a>
                </li>
            }
        }
        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")" style="cursor:pointer;">
            <a class="page-link" data-page_num="@(Model.CurrentPage + 1)">
                <i class="fas fa-angle-right"></i>
            </a>
        </li>
        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")" style="cursor:pointer;">
            <a class="page-link" data-page_num="@(Model.TotalPages)">
                <i class="fas fa-angle-double-right"></i>
            </a>
        </li>
    </ul>
</nav>
<div class="row">
    <div class="col-12 d-flex flex-wrap justify-content-center justify-content-md-end">
        <label class="text-muted"> @Model.TotalItems registros</label>
    </div>
</div>