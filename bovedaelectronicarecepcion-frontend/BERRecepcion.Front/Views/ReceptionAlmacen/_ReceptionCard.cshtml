@using BERRecepcion.Front.Models.Dto
@model DataResult<IEnumerable<ReceptionDto>>
@using Newtonsoft.Json
@{
    bool hasData = Model != null && Model.Data != null && Model.Data.Count() > 0;
}

<div class="card">
    <div class="card-header">
        <div class="row">
            <div class="col-md-8">
                @if (hasData)
                {
                    <h6>Información de la recepción</h6>
                    <small>Seleccione el documento a firmar</small>
                }
            </div>
            <div class="col-md-4">
                <form id="reception-form-search">
                    <div class="input-group">
                        <input type="search" class="form-control form-control-sm" autocomplete="off" placeholder="Búsqueda de recepciones" value="@ViewBag.Search" id="search">
                        <div class="input-group-append">
                            <button type="submit" class="btn btn-sm btn-default">
                                <i class="fa fa-search"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="card-body">
        @if (hasData)
        {
            <table class="table table-hover" id="reception-table" style="font-size:14px;">
                <thead>
                    <tr>
                        <th class="text-center">PDF</th>
                        <th></th>
                        <th>Recepción</th>
                        <th>SIAF</th>
                        <th>OS</th>
                        <th>Contrato</th>
                        <th>Organismo</th>
                        <th class="text-right">Total</th>
                        <th>Moneda</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Data)
                    {
                        <tr>
                            <td scope="row" class="text-center">
                                <i class="fas fa-file-pdf image-pdf pdf-red-color" data-receptionid = "@item.ReceptionID"></i>
                            </td>
                            <td scope="row" class="text-center">
                                @{
                                    var _model = new Dictionary<string, object>
                                        {
                                            {"ItemID", item.ReceptionID }, //Obligatorio para estandarizar ID's
                                            {"Descripcion", string.Concat(item.Reception, " - ", item.Contract) },
                                            {"ReceptionID", item.ReceptionID },
                                            {"SapOrder", item.SapOrder },
                                            {"Contract", item.Contract },
                                            {"Clave", item.Clave },
                                        };
                                }
                                <div class="custom-control custom-checkbox">
                                    <input class="custom-control-input custom-control-input-danger custom-control-input-outline" type="checkbox" name="checkPDF" id="@item.ReceptionID" @((ViewBag.PDFCheckDisabled == null || ViewBag.PDFCheckDisabled) ? "disabled" : "") data-model="@JsonConvert.SerializeObject(_model)" />
                                    <label class="custom-control-label" for="@item.ReceptionID"></label>
                                </div>
                            </td>
                            <td scope="row">@item.Reception</td>
                            <td scope="row">@item.SiafOrder</td>
                            <td scope="row">@item.SapOrder</td>
                            <td scope="row">@item.Contract</td>
                            <td scope="row">@item.Clave</td>
                            <td scope="row" class="text-right">$@String.Format("{0:#,##0.#0}", Convert.ToDouble(item.Total))</td>
                            <td scope="row">@item.Currency</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="row mt-2">
                <div class="col-12 col-sm-3 col-md-2 col-lg-2 col-xl-2 mt-1 mb-2">
                    <button class="btn btn-sm btn-outline-success w-100" onclick="validarInfo(event);" style="width:100px;">
                        Firmar<i class="fas fa-pencil-alt float-right mt-1"></i>
                    </button>
                </div>
                <div class="col-12 col-sm-9 col-md-10 col-lg-10 col-xl-10">
                    <partial name="_Pagination" model="@Model.Pager" />
                </div>
            </div>
            <script>
                $(function () {
                    DataTableInitialize("reception-table");
                });
            </script>
        }
        else
        {
            <div class="callout callout-info">
                <p>No se han encontrado recepciones.</p>
            </div>
        }
    </div>
    <!-- /.card-body -->
</div>