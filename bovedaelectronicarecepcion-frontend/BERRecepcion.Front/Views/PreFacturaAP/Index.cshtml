@{
    ViewData["Title"] = "Pre Factura";
}

@Html.Hidden("urlCG", Url.Action("BusquedaPreFactura"))

<div class="content-header" id="titulo">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Consulta de Pre Factura de Analitico de Pago</h1>
            </div>
        </div>
    </div>
</div>


<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <form id="consulta-form-search">
                        <div class="card-header">
                            <h5 class="mb-0 text-olive">
                                <i class="fa fa-filter"></i> Filtro
                                <button class="btn btn-sm btn-outline-success float-right ml-1" style="width:135px;display:none;" id="btnExcel"><span class="fas fa-download"></span> Descargar Excel</button>
                                <button class="btn btn-sm btn-outline-success float-right" style="width:135px;display:none;" id="btnValidarInfo"><span class="fas fa-download"></span> Descargar XML</button>
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="form-row">
                                <div class="form-group col-md-3">
                                    <label class="col-form-label col-form-label-sm" for="FechaInicial">Fecha Inicial</label>
                                    <input type="date" class="form-control form-control-sm" id="FechaInicial" max="@DateTime.Now.ToString("yyyy-MM-dd")">
                                </div>
                                <div class="form-group col-md-3">
                                    <label class="col-form-label col-form-label-sm" for="FechaFinal">Fecha Final</label>
                                    <input type="date" class="form-control form-control-sm" id="FechaFinal" max="@DateTime.Now.ToString("yyyy-MM-dd")">
                                </div>
                                <div class="form-group col-md-5">
                                    <label class="col-form-label col-form-label-sm" for="Busqueda">Texto</label>
                                    <input type="text" class="form-control form-control-sm search" id="Busqueda" placeholder="Buscar">
                                </div>
                                <div class="form-group col-md-1">
                                    <label class="col-form-label col-form-label-sm" for="btnBuscar" style="visibility: hidden;">.</label>
                                    <button type="submit" class="btn btn-sm btn-default w-100" id="btnBuscar">
                                        <i class="fa fa-search"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="form-row ml-0" id="searchTerms">

                            </div>
                            <div class="col-12" id="preFacturaAP-card">

                            </div>
                        </div>
                    </form>
                    
                </div>
            </div>
        </div>
    </div>
    
</section>


@section scripts{
    <script type="text/javascript" src="@Url.Content("~/js/PreFacturaAP/index.js" )"></script>
    <script type="text/javascript" src="@Url.Content("~/js/Consultas/search.js")"></script>
}


<partial name="_Modal" />